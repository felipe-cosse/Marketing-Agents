# Safe local defaults. Copy to .env only for local development.
APP_ENV=local
AUTH_MODE=local
DATABASE_URL=sqlite+aiosqlite:///./data/marketing_agents.db
CATALOG_ROOT=./catalog/v1
LLM_PROVIDER=mock
CONNECTOR_MODE=mock
ALLOW_EXTERNAL_NETWORK=false
API_HOST=127.0.0.1
API_PORT=8000
MARKETING_AGENTS_DIGEST_KEY_PATH=./data/digest.key

# Optional real-provider credentials remain blank. Real mode also requires
# separate provider and external-network opt-ins that are disabled above.
REAL_LLM_API_KEY=
