# Safe local defaults. Copy to .env only for local development.
APP_ENV=local
AUTH_MODE=local
DATABASE_URL=sqlite+aiosqlite:///./data/marketing_agents.db
CATALOG_ROOT=./catalog/v1
LLM_PROVIDER=mock
CONNECTOR_MODE=mock
ALLOW_EXTERNAL_NETWORK=false
REAL_LLM_OPT_IN=false
REAL_CONNECTOR_OPT_IN=false
API_HOST=127.0.0.1
API_PORT=8000
MARKETING_AGENTS_DIGEST_KEY_PATH=./data/digest.key
RETENTION_ADMITTED_PAYLOAD_DAYS=7
RETENTION_EXTERNAL_ACTION_PAYLOAD_DAYS=7
RETENTION_APPROVAL_DETAIL_DAYS=7
RETENTION_ARTIFACT_DETAIL_DAYS=30
RETENTION_CONNECTOR_RECEIPT_DETAIL_DAYS=30
RETENTION_AUDIT_METADATA_DAYS=90

# Optional real-provider credentials remain blank. Real mode also requires
# separate provider and external-network opt-ins that are disabled above.
REAL_LLM_API_KEY=

# Optional local webhook signing secret. Keep unset until a server-owned webhook
# source definition is installed; use at least 32 bytes when enabled.
WEBHOOK_HMAC_SECRET=
