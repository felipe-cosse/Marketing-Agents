{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-agents:catalog:function:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "department_id", "display_name", "display_order", "source_references"],
  "properties": {
    "id": {"type": "string", "pattern": "^func\\.[a-z0-9-]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "department_id": {"type": "string", "pattern": "^dept\\."},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "display_order": {"type": "integer", "minimum": 1, "maximum": 10000},
    "source_references": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  }
}
