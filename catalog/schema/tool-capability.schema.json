{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-agents:catalog:tool-capability:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "effect", "connector_family", "idempotency_support", "default_timeout_seconds"],
  "properties": {
    "id": {"type": "string", "pattern": "^cap\\.[a-z0-9-]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 300},
    "effect": {"enum": ["read", "write"]},
    "connector_family": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "idempotency_support": {"enum": ["not_applicable", "required", "supported", "unavailable"]},
    "default_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "data_classification": {"enum": ["public", "internal", "personal", "sensitive"]}
  }
}
