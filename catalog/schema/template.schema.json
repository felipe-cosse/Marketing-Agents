{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-agents:catalog:template:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "display_name", "department_id", "function_id", "display_order", "purpose",
    "system_prompt_ref", "input_schema_ref", "output_schema_ref", "allowed_tool_capability_ids",
    "supported_trigger_types", "operation_classification", "approval_policy_id", "retry_policy",
    "timeout_policy", "budget_policy", "rate_limit_policy", "source_confidence", "source_references",
    "implementation_notes"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^tpl\\.[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
    "department_id": {"type": "string", "pattern": "^dept\\."},
    "function_id": {"type": "string", "pattern": "^func\\."},
    "display_order": {"type": "integer", "minimum": 1, "maximum": 10000},
    "purpose": {"type": "string", "minLength": 10, "maxLength": 600},
    "system_prompt_ref": {"$ref": "#/$defs/localPath"},
    "input_schema_ref": {"$ref": "#/$defs/localPath"},
    "output_schema_ref": {"$ref": "#/$defs/localPath"},
    "allowed_tool_capability_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^cap\\."}},
    "supported_trigger_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["manual", "webhook", "schedule"]}},
    "operation_classification": {"enum": ["read_only", "mutating"]},
    "approval_policy_id": {"type": "string", "pattern": "^policy\\."},
    "retry_policy": {
      "type": "object", "additionalProperties": false, "required": ["max_attempts", "backoff"],
      "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}, "backoff": {"enum": ["none", "bounded_exponential"]}}
    },
    "timeout_policy": {
      "type": "object", "additionalProperties": false, "required": ["step_seconds", "run_seconds"],
      "properties": {"step_seconds": {"type": "integer", "minimum": 1, "maximum": 120}, "run_seconds": {"type": "integer", "minimum": 1, "maximum": 600}}
    },
    "budget_policy": {
      "type": "object", "additionalProperties": false, "required": ["max_steps", "max_model_calls", "max_tool_calls"],
      "properties": {"max_steps": {"type": "integer", "minimum": 1, "maximum": 20}, "max_model_calls": {"type": "integer", "minimum": 0, "maximum": 10}, "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 20}}
    },
    "rate_limit_policy": {
      "type": "object", "additionalProperties": false, "required": ["max_calls", "window_seconds"],
      "properties": {"max_calls": {"type": "integer", "minimum": 1, "maximum": 100}, "window_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}
    },
    "source_confidence": {"enum": ["high", "medium", "low"]},
    "source_references": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "implementation_notes": {"type": "string", "maxLength": 1000}
  },
  "$defs": {
    "localPath": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"}
  }
}
