{
  "name": "@marketing-agents/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "browser:install:ci": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install --with-deps chromium",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-web-e2e.mjs",
    "test:web-01": "pnpm test:web-01:unit && pnpm test:web-01:e2e",
    "test:web-01:e2e": "node scripts/run-web-01-e2e.mjs",
    "test:web-01:unit": "node scripts/run-web-01-unit.mjs",
    "test:web-01:witness": "node scripts/run-web-01-witness.mjs",
    "test:web-02": "pnpm test:web-02:unit && pnpm test:web-02:e2e",
    "test:web-02:e2e": "node scripts/run-web-02-e2e.mjs",
    "test:web-02:unit": "node scripts/run-web-02-unit.mjs",
    "test:web-02:witness": "node scripts/run-web-02-witness.mjs",
    "test:web-03": "pnpm test:web-03:unit && pnpm test:web-03:e2e",
    "test:web-03:e2e": "node scripts/run-web-03-e2e.mjs",
    "test:web-03:unit": "node scripts/run-web-03-unit.mjs",
    "test:web-03:witness": "node scripts/run-web-03-witness.mjs",
    "test:web-04": "pnpm test:web-04:unit && pnpm test:web-04:e2e",
    "test:web-04:e2e": "node scripts/run-web-04-e2e.mjs",
    "test:web-04:unit": "node scripts/run-web-04-unit.mjs",
    "test:web-04:witness": "node scripts/run-web-04-witness.mjs",
    "test:web-05": "pnpm test:web-05:unit && pnpm test:web-05:e2e",
    "test:web-05:e2e": "node scripts/run-web-05-e2e.mjs",
    "test:web-05:unit": "node scripts/run-web-05-unit.mjs",
    "test:web-05:witness": "node scripts/run-web-05-witness.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
