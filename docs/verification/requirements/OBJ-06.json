  "claims": [
    {
      "id": "chart-configuration-and-runtime",
      "type": "positive",
      "statement": "The chart's graph and tree show observed per-instance run status separately from deployment state, preserve hierarchy layout and viewport on status updates, and expose unavailable data honestly. Rendered configuration edits persist and disabled deployments withhold manual admission controls.",
      "test_refs": [
        "apps/web/src/features/org-chart/AgentCard.test.tsx",
        "apps/web/src/features/org-chart/OrgChartCanvas.test.tsx",
        "apps/web/src/features/org-chart/OrgTreeFallback.test.tsx",
        "apps/web/e2e/obj-06-control-surface.spec.ts"
      ]
    },
    {
      "id": "guarded-admission-navigation",
      "type": "negative_control",
      "statement": "Accepted manual runs open their exact timeline via guarded client navigation. Admission clears only submitted input; independent configuration drafts remain protected, including edits during pending admission. Errors do not navigate, repeat admission or claim refresh success. Receipt activation preserves native modified-click behavior.",
      "test_refs": [
        "apps/web/src/features/dry-run/DryRunPanel.test.tsx",
        "apps/web/src/features/org-chart/OrgChartPage.test.tsx",
        "apps/web/e2e/obj-06-control-surface.spec.ts",
        "apps/web/e2e/web-04-dry-run.spec.ts"
      ]
    },
    {
      "id": "scoped-approval-and-results",
      "type": "journey",
      "statement": "A real fresh local installation supports chart configuration, mock admission, exact run-scoped approval review, explicit confirmation and a sequence-ordered completed receipt. Cancelling review causes no dispatch. A separate mobile READ journey opens a produced artifact. Route scope changes reset stale review state; no real delivery is asserted.",
      "test_refs": [
        "apps/web/e2e/obj-06-control-surface.spec.ts",
        "apps/web/src/features/approvals/ApprovalQueuePage.test.tsx",
        "apps/web/src/features/runs/RunTimelinePage.test.tsx"
      ]
    },
    {
      "id": "bounded-real-browser-evidence",
      "type": "negative_control",
      "statement": "The real-system browser harness preserves genuine browser Origin and Fetch Metadata, rejects unexpected off-origin transport and redirects before follow, uses temporary state with real API/workers, and reaps owned processes. Browser inventory retains explicit exhaustive ownership; the dependency-free witness rejects disconnected control wiring.",
      "test_refs": [
        "apps/web/config/obj-06-network-canary.spec.ts",
        "tests/tooling/test_obj_06_browser_harness.py",
        "tests/network/obj_06_control_witness.test.mjs",
        "tests/network/web_e2e_inventory.test.mjs"
      ]
    }
  ],
