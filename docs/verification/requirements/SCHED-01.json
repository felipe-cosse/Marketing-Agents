  "claims": [
    {
      "id": "iana-wall-clock-next-utc",
      "type": "contract",
      "statement": "Schedule configuration preserves the exact original five-field cron and IANA timezone key while calculating the first strictly future aware UTC instant. Spring gaps advance to the first valid local instant, and fall folds select the earlier UTC instant once.",
      "test_refs": [
        "tests/unit/scheduler/test_sched_01_recurrence.py::test_sched_01_service_preserves_original_iana_key_and_seals_next_utc_run",
        "tests/unit/scheduler/test_sched_01_recurrence.py::test_sched_01_spring_gap_advances_to_next_valid_local_instant",
        "tests/unit/scheduler/test_sched_01_recurrence.py::test_sched_01_fall_fold_chooses_earlier_utc_instant_once"
      ]
    },
    {
      "id": "fail-closed-recurrence-boundary",
      "type": "negative_control",
      "statement": "The configuration boundary rejects unsupported or impossible cron syntax, unknown timezone keys, non-UTC calculation boundaries, and recurrence adapters that return a naive, non-UTC, or nonfuture instant before creating a Schedule.",
      "test_refs": [
        "tests/unit/scheduler/test_sched_01_recurrence.py::test_sched_01_invalid_cron_timezone_and_boundary_fail_closed",
        "tests/unit/scheduler/test_sched_01_recurrence.py::test_sched_01_service_rejects_nonfuture_or_nonutc_adapter_results"
      ]
    },
    {
      "id": "durable-timezone-next-run-roundtrip",
      "type": "contract",
      "statement": "A service-calculated Schedule persists through the unit of work and a file-backed SQLite restart with its exact original timezone key and aware UTC projection. SQLite and PostgreSQL DDL expose the required columns and enabled-next-run-ID index.",
      "test_refs": [
        "tests/integration/db/test_sched_01_schedule_persistence.py::test_sched_01_schedule_schema_is_portable_and_indexed_by_next_utc_run",
        "tests/integration/db/test_sched_01_schedule_persistence.py::test_sched_01_round_trip_preserves_original_zone_and_next_utc_across_restart",
        "tests/integration/db/test_sched_01_schedule_persistence.py::test_sched_01_calculated_next_utc_is_the_exact_restart_persisted_value"
      ]
    },
    {
      "id": "exact-replay-rollback-row-consistency",
      "type": "negative_control",
      "statement": "Initial persistence returns an exact authoritative replay for the same ID, rejects changed create-time facts, rolls back uncommitted insertion, enforces row constraints, and detects unrecomputed timezone, cron, or next-run drift through a domain-separated consistency digest.",
      "test_refs": [
        "tests/integration/db/test_sched_01_schedule_persistence.py::test_sched_01_round_trip_preserves_original_zone_and_next_utc_across_restart",
        "tests/integration/db/test_sched_01_schedule_persistence.py::test_sched_01_same_id_with_changed_create_facts_is_rejected",
        "tests/integration/db/test_sched_01_schedule_persistence.py::test_sched_01_uncommitted_insert_rolls_back",
        "tests/integration/db/test_sched_01_schedule_persistence.py::test_sched_01_constraints_reject_invalid_persisted_configuration",
        "tests/integration/db/test_sched_01_schedule_persistence.py::test_sched_01_hydration_fails_closed_on_valid_looking_tampering"
      ]
    }
