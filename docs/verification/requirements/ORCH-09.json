  "claims": [
    {
      "id": "atomic-plan-step-snapshot",
      "type": "contract",
      "statement": "One validated Run accepts a complete bounded read-only plan snapshot containing selected instances, routing assignments, ordered steps, dependencies, and exact initial step histories; the shared RUN-02 hash binds every persisted RunStep execution field plus the stored graph and routing digests, rows commit or roll back together, and replay never heals missing history.",
      "test_refs": [
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_restart_stable_complete_plan_step_timeline",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_plan_and_audit_fault_roll_back_every_row",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_same_run_plan_race_has_one_complete_canonical_winner",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_identical_structural_plan_hash_is_scoped_per_run",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_plan_replay_rejects_missing_initial_step_history"
      ]
    },
    {
      "id": "same-uow-run-step-mutations",
      "type": "negative_control",
      "statement": "Accepted Run and read-step mutations append their typed event in the exact mutation unit of work; audit failure rolls back state and history, Run completion derives persisted step results, and readiness revalidates the full persisted dependency graph so forged counts or a missing edge cannot authorize progress.",
      "test_refs": [
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_single_audit_append_fault_rolls_back_run_and_step_mutations",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_completion_uses_persisted_steps_and_audits_rejection",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_missing_dependency_row_cannot_turn_child_into_root",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_structural_step_tamper_blocks_activation_without_healing",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_structural_tamper_after_ready_blocks_start_without_healing",
        "tests/unit/domain/test_orch_09_audit_contracts.py::test_orch_09_step_lifecycle_has_exhaustive_effect_aware_edges",
        "tests/unit/domain/test_orch_09_audit_contracts.py::test_orch_09_transition_contract_rejects_forged_edges_and_mutation"
      ]
    },
    {
      "id": "typed-redacted-append-only-events",
      "type": "negative_control",
      "statement": "Audit contexts use integrity-checked pseudonymous subject and correlation identifiers, event-specific bounded metadata is redacted and revalidated during hydration, impossible lifecycle shapes fail closed, and the repository exposes append and read operations without event update or delete methods.",
      "test_refs": [
        "tests/security/test_orch_09_audit_redaction.py::test_orch_09_audit_context_pseudonymizes_canaries_and_detects_mutation",
        "tests/security/test_orch_09_audit_redaction.py::test_orch_09_persisted_metadata_is_revalidated_not_trusted_by_fingerprint",
        "tests/security/test_orch_09_audit_redaction.py::test_orch_09_audit_repository_has_no_event_update_or_delete_surface",
        "tests/unit/domain/test_orch_09_audit_contracts.py::test_orch_09_raw_audit_hydration_rejects_impossible_initial_mutation"
      ]
    },
    {
      "id": "stable-per-run-sequence-and-rejections",
      "type": "contract",
      "statement": "A transactionally allocated per-Run counter gives committed events a contiguous run_sequence, including concurrent independent step transitions; rejected Run attempts use distinct stable attempt identities without claiming mutation versions, replay consumes no sequence, and missing timeline rows prevent reads and extension rather than being backfilled.",
      "test_refs": [
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_parallel_steps_allocate_contiguous_same_run_audit_sequences",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_caller_owned_rejection_is_typed_and_committable",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_rejected_attempt_identity_replays_without_consuming_sequence",
        "tests/integration/db/test_orch_09_audited_step_state.py::test_orch_09_timeline_gap_rejects_reads_and_cannot_be_extended"
      ]
    }
