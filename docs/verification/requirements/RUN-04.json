      "id": "canonical-keyed-admission",
      "type": "contract",
      "statement": "Admitted payload and complete routing, mode, brief, and configuration context use separate canonical HMAC-SHA256 domains bound to the installed digest-key fingerprint version.",
      "test_refs": [
        "tests/unit/domain/test_run_04_admission_digest.py::test_run_04_digest_is_restart_stable_canonical_keyed_and_secret_safe",
