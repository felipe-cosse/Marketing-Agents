      ]
    },
    {
      "id": "all-write-proposals-before-release",
      "type": "contract",
      "statement": "Every write step receives one exact immutable proposal and one matching pending approval request in a shared authorization set before the plan can leave planning.",
      "test_refs": [
                "tests/unit/application/test_run_02_effect_aware_planning.py::test_run_02_all_writes_are_proposed_before_one_authorization_set_releases",
                "tests/unit/application/test_run_02_effect_aware_planning.py::test_run_02_real_mixed_route_proposes_exact_redacted_action_and_pauses"
      ]
    },
