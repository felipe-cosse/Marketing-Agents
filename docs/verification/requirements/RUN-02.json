      "id": "zero-write-calls-before-approval",
      "type": "negative_control",
      "statement": "Planning accepts metadata, graph, route, typed command, effective binding, clock, and ID ports only; failures create no authority, no connector is injectable, and the gate denies network sockets.",
      "test_refs": [
        "tests/unit/application/test_run_02_effect_aware_planning.py::test_run_02_invalid_effective_binding_fails_before_authority",
        "tests/unit/application/test_run_02_effect_aware_planning.py::test_run_02_missing_effective_binding_fails_before_authority",
        "tests/unit/application/test_run_02_effect_aware_planning.py::test_run_02_effect_or_command_forgery_fails_closed"
      ]
    },
