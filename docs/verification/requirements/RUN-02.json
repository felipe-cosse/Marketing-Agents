  "claims": [
    {
      "id": "trusted-effect-direct-or-paused",
      "type": "contract",
      "statement": "The planner snapshots catalog and registry metadata supplied by trusted composition and requires its catalog release label to match the route: reads release directly, while any validated write produces an approval-required disposition bound to the structural hash.",
      "test_refs": [
        "tests/unit/application/test_run_02_effect_aware_planning.py::test_run_02_read_only_plan_releases_directly_without_time_or_ids",
        "tests/unit/application/test_run_02_effect_aware_planning.py::test_run_02_real_mixed_route_proposes_exact_redacted_action_and_pauses",
