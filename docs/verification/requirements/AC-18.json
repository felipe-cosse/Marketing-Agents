  "claims": [
    {
      "id": "authoritative-counter-and-rejection-preservation",
      "type": "negative_control",
      "statement": "The current 26 authoritative counters, network classification, control rejection, read sizes, typed pending cleanup and full-width native EINVAL VMA qualification remain intact. Appended diagnostic bins neither authorize a failed read nor add a second rejection. The network bytecode remains unchanged.",
      "test_refs": [
        "tests/tooling/test_ac_15_kernel_bytecode.py",
        "tests/tooling/test_ac_15_kernel_collector.py",
        "tests/tooling/test_ac_15_kernel_protocol.py"
      ]
    },
    {
      "id": "bounded-conserved-read-diagnostics",
      "type": "contract",
      "statement": "Nine fixed read sites each expose only EFAULT, other nonzero result or pre-helper pointer-wrap counts. Exact signed 64-bit EFAULT classification and conservation against control_read_error are mandatory. Missing, malformed, negative, inconsistent or incompatible counter evidence fails closed.",
      "test_refs": [
        "tests/tooling/test_ac_15_kernel_bytecode.py",
        "tests/tooling/test_ac_15_kernel_collector.py",
        "tests/tooling/test_ac_15_kernel_protocol.py"
      ]
    },
    {
      "id": "current-source-native-vma-diagnostic",
      "type": "journey",
      "statement": "A separate native-only runner compares untouched, pre-read and inaccessible owned mappings with the current source-bound collector and live kernel configuration. It selects an already acquired immutable image for clean HEAD, never builds or pulls, and cannot turn completed diagnostics into an acceptance pass.",
      "test_refs": [
        "tests/tooling/test_ac_15_vma_diagnostic.py"
      ]
    },
    {
      "id": "diagnostic-privacy-and-owned-lifecycle",
      "type": "negative_control",
      "statement": "Diagnostic output contains bounded categories, counts and source/kernel identities, never user names, labels, addresses, buffer contents, raw helper results or unrestricted exception text. Fresh owned network-none targets retain existing boundaries and cleanup; failures, unsupported execution and incomplete evidence cannot become success.",
      "test_refs": [
        "tests/tooling/test_ac_15_kernel_collector.py",
        "tests/tooling/test_ac_15_kernel_protocol.py",
        "tests/tooling/test_ac_15_vma_diagnostic.py"
      ]
    },
    {
      "id": "bounded-registry-schema-structure-reuse",
      "type": "negative_control",
      "statement": "The separately approved optimization reuses only successful schema-structure validation for identical freshly canonicalized content and expected identity within one workflow registry build. Identity, dialect, local-reference, workflow and payload checks remain mandatory; validators remain fresh, standalone compilation remains fully checked, and the reuse scope ends on success or failure. No catalog, database-reflection or process-global validation cache is introduced.",
      "test_refs": [
        "tests/unit/application/test_api_08_json_schema_policy.py",
        "tests/unit/application/test_obj_03_executable_workflows.py"
      ]
    },
    {
      "id": "complete-frozen-source-qualification",
      "type": "contract",
      "statement": "The exact frozen candidate requires the complete 20-gate quality run and matching audit, all four complete AC-15 offline suites, a separate live diagnostic, committed clean-state production-browser verification and both paired Compose recovery paths. Existing checks, inventories, coverage, deadlines and Docker settings are retained.",
      "test_refs": [
        "tests/tooling/test_ac_15_kernel_bytecode.py",
        "tests/tooling/test_ac_15_vma_diagnostic.py"
      ]
    }
  ],
