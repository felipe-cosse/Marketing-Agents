        "tests/unit/application/test_api_05_webhook_admission_service.py::test_api_05_authenticated_same_event_different_body_commits_collision_only",
        "tests/unit/application/test_api_05_webhook_admission_service.py::test_api_05_exact_replay_ignores_later_binding_configuration_drift",
        "tests/integration/db/test_api_05_webhook_intake.py::test_api_05_restart_replay_survives_configuration_drift_and_changed_body_collides"
      ]
