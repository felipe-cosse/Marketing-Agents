  "claims": [
    {
      "id": "bounded-raw-authenticated-transport",
      "type": "contract",
      "statement": "POST /api/v1/webhooks/{source}/{trigger_id} preserves exact unencoded JSON bytes and duplicate authentication headers for application verification, rejects malformed or oversized transport before service invocation, bypasses local browser identity, bounds the service wait to five seconds, and returns non-cacheable typed 202 fan-out receipts or fixed non-reflective errors without claiming execution.",
      "test_refs": [
        "tests/integration/api/test_api_05_webhooks.py::test_api_05_preserves_exact_body_and_headers_without_local_identity",
        "tests/integration/api/test_api_05_webhooks.py::test_api_05_returns_typed_202_fan_out_without_claiming_execution",
        "tests/integration/api/test_api_05_webhooks.py::test_api_05_maps_service_errors_to_non_reflective_stable_problems",
        "tests/integration/api/test_api_05_webhooks.py::test_api_05_requires_one_unencoded_application_json_transport",
        "tests/integration/api/test_api_05_webhooks.py::test_api_05_raw_body_limit_accepts_boundary_and_rejects_buffered_and_chunked_excess",
        "tests/integration/api/test_api_05_webhooks.py::test_api_05_timeout_cancels_executor_and_returns_bounded_503",
        "tests/integration/api/test_api_05_webhooks.py::test_api_05_openapi_exposes_only_exact_webhook_transport_contract"
      ]
    },
    {
      "id": "signature-before-mapping-and-server-routing",
      "type": "negative_control",
      "statement": "The HMAC-SHA256 adapter resolves only an opaque environment secret reference, authenticates a bounded timestamp plus exact raw bytes, and issues sealed source-trigger authority before mapping. The registry enforces one trigger, secret reference, and verifier per source plus a mapper-owned version. The strict mapper accepts only eventId and input; the compiled resolver selects enabled explicit source targets, so payload text, local identity, and registration alone cannot choose a target.",
      "test_refs": [
        "tests/unit/webhooks/test_api_05_hmac_verifier.py::test_api_05_verifies_exact_raw_bytes_and_issues_exact_service_authority",
        "tests/unit/webhooks/test_api_05_hmac_verifier.py::test_api_05_rejects_missing_and_case_insensitive_duplicate_auth_headers",
        "tests/unit/webhooks/test_api_05_hmac_verifier.py::test_api_05_freshness_and_future_skew_boundaries_are_inclusive",
        "tests/unit/webhooks/test_api_05_hmac_verifier.py::test_api_05_secret_resolution_is_reference_only_and_fails_closed",
        "tests/unit/webhooks/test_api_05_hmac_verifier.py::test_api_05_settings_and_example_never_expose_or_ship_a_webhook_secret",
        "tests/unit/webhooks/test_api_05_input_mapping.py::test_api_05_mapper_accepts_only_event_id_and_input_without_routing_authority",
        "tests/unit/webhooks/test_api_05_input_mapping.py::test_api_05_mapper_rejects_ambiguous_or_noncanonical_envelopes",
        "tests/unit/webhooks/test_api_05_input_mapping.py::test_api_05_source_definition_binds_the_mapper_implementation_version",
        "tests/unit/webhooks/test_api_05_input_mapping.py::test_api_05_registry_rejects_shared_source_or_secret_authority",
        "tests/unit/webhooks/test_api_05_input_mapping.py::test_api_05_registry_rejects_reusing_one_verifier_authority",
        "tests/unit/application/test_api_05_webhook_admission_service.py::test_api_05_signature_rejection_precedes_json_mapping_and_work_resolution",
        "tests/unit/application/test_api_05_webhook_admission_service.py::test_api_05_invalid_verifier_output_is_adapter_unavailable_not_auth_denial",
        "tests/integration/db/test_api_05_webhook_intake.py::test_api_05_registered_source_without_explicit_instance_binding_is_forbidden"
      ]
    },
    {
      "id": "keyed-exact-body-idempotency",
      "type": "positive",
      "statement": "A domain-separated keyed body digest and its key-version label bind exact authenticated bytes without persisting or exposing the raw body. The unique source-event receipt records its trigger and mapper version, exact replay returns the authoritative original aggregate across restart and later configuration drift, and a valid signature over changed bytes for the same event commits only a collision witness with no new target work.",
      "test_refs": [
        "tests/unit/webhooks/test_api_05_body_digest.py::test_api_05_body_digest_is_restart_stable_exact_byte_sensitive_and_redacted",
