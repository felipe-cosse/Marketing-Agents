        "tests/unit/application/test_api_05_webhook_admission_service.py::test_api_05_partial_fan_out_failure_never_commits_receipt_or_audit",
        "tests/unit/application/test_api_05_webhook_admission_service.py::test_api_05_rechecks_receipt_after_serialization_lock_wait",
        "tests/unit/application/test_api_05_webhook_admission_service.py::test_api_05_receipt_bound_matches_the_fixed_43_instance_catalog",
        "tests/integration/db/test_api_05_webhook_intake.py::test_api_05_authenticated_intake_creates_two_target_receipt_without_audit_leaks",
        "tests/integration/db/test_api_05_webhook_intake.py::test_api_05_concurrent_exact_replay_creates_one_complete_fanout",
        "tests/integration/db/test_api_05_webhook_intake.py::test_api_05_fault_after_webhook_audit_flush_rolls_back_complete_fanout",
        "tests/integration/db/test_api_05_webhook_receipts.py::test_api_05_complete_fanout_round_trips_and_replays_authoritative_receipt",
        "tests/integration/db/test_api_05_webhook_receipts.py::test_api_05_receipt_rolls_back_without_an_explicit_outer_commit",
        "tests/integration/db/test_api_05_webhook_receipts.py::test_api_05_unrelated_work_or_run_reuse_fails_without_partial_receipt",
        "tests/integration/db/test_api_05_webhook_receipts.py::test_api_05_database_rejects_contradictory_delivery_links",
        "tests/integration/db/test_api_05_webhook_receipts.py::test_api_05_database_rejects_cross_linked_run_and_work_pairs"
      ]
    },
    {
      "id": "ordered-redacted-webhook-audit",
      "type": "negative_control",
      "statement": "Rejected signatures are witnessed only under the pre-verification system identity; authenticated validation, receipt creation, duplicate suppression, collision, and schema rejection use the sealed webhook service identity. Durable assertions prove exact event families and rollback behavior while raw bodies, event IDs, signatures, secrets, secret references, body and admission digests, and digest key versions remain absent from audit metadata.",
      "test_refs": [
