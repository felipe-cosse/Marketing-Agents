        "tests/unit/application/test_api_05_webhook_audit_events.py::test_api_05_receipt_events_have_exact_bounded_dispositions",
        "tests/unit/application/test_api_05_webhook_audit_events.py::test_api_05_webhook_metadata_rejects_all_raw_or_secret_material",
        "tests/unit/application/test_api_05_webhook_audit_events.py::test_api_05_public_audit_methods_expose_no_raw_or_secret_parameter_seams",
        "tests/integration/db/test_api_05_webhook_intake.py::test_api_05_invalid_signature_precedes_mapper_and_business_persistence",
