  "claims": [
    {
      "id": "schema-bound-redacted-admitted-input",
      "type": "negative_control",
      "statement": "Incoming work derives one validator-issued immutable redacted projection from its exact JSON Schema, persists the schema ID, canonical schema hash, highest retained classification, retention timestamps, and keyed integrity digest, replays those facts exactly, and rejects secret-classified material or projection and schema drift before persistence.",
      "test_refs": [
        "tests/security/test_run_06_input_redaction.py::test_run_06_projection_is_schema_bound_redacted_immutable_and_replayed_exactly",
        "tests/security/test_run_06_input_redaction.py::test_run_06_projection_metadata_tamper_fails_closed",
        "tests/security/test_run_06_input_redaction.py::test_run_06_semantic_replay_rejects_wrong_schema_identity",
        "tests/security/test_run_06_input_redaction.py::test_run_06_validator_projection_tamper_and_secret_classification_fail_closed"
      ]
    },
    {
      "id": "exact-redacted-attempt-facts-and-safe-errors",
      "type": "negative_control",
      "statement": "Each model or tool attempt persists its exact Run, Step, operation, policy, attempt number, reservation and deadline times, input schema and classification, redacted input, completion outcome, retry or terminal facts, allowlisted safe error, and successful artifact link under integrity verification; payload and provider error detail never enter audit metadata.",
      "test_refs": [
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_orch_06_first_start_commits_before_adapter_and_success_completes_later",
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_run_06_personal_attempt_input_is_fully_masked_with_incomplete_pointers",
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_run_06_schema_invalid_output_is_safe_and_has_no_artifact",
        "tests/security/test_run_06_timeline_redaction.py::test_run_06_attempt_metadata_retains_only_bounded_typed_codes",
        "tests/security/test_run_06_timeline_redaction.py::test_run_06_safe_error_hydration_rejects_secret_canary_and_unknown_code"
      ]
    },
    {
      "id": "pre-call-frozen-schema-and-no-artifact-failure",
      "type": "negative_control",
      "statement": "Before reserving or calling an adapter, controlled READ obtains one immutable output contract whose ID, canonical content hash, classification, and provider kind must match the sealed plan and operation. Every returned object is validated against that exact frozen Draft 2020-12 schema, and schema drift or an invalid result precedes the call or retains only output_schema_invalid with no output artifact.",
      "test_refs": [
        "tests/unit/domain/test_run_06_timeline_contracts.py::test_run_06_runtime_output_schema_hash_is_canonical_and_content_bound",
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_run_06_same_schema_id_changed_body_precedes_attempt_and_budget_mutation",
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_orch_06_adapter_contract_drift_precedes_attempt_and_budget_mutation",
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_run_06_schema_invalid_output_is_safe_and_has_no_artifact"
      ]
    },
    {
      "id": "immutable-schema-hash-bound-artifact-lineage",
      "type": "contract",
      "statement": "A successful controlled READ atomically persists one immutable structured artifact bound to its exact Work, Run, plan, Step, selected instance and configuration, admitted-input digest, source classifications, provider version, output schema ID, version and content hash, payload hash, and creation time; exact replay succeeds while tamper, cross-Run parents, and non-ancestor lineage fail closed.",
      "test_refs": [
        "tests/integration/db/test_run_06_artifact_persistence.py::test_run_06_artifact_round_trip_exact_replay_conflict_and_stable_run_order",
        "tests/integration/db/test_run_06_artifact_persistence.py::test_run_06_parent_edges_require_exact_same_run_ancestor_lineage",
        "tests/integration/db/test_run_06_artifact_persistence.py::test_run_06_payload_or_provenance_tamper_fails_closed",
        "tests/integration/db/test_run_06_artifact_persistence.py::test_run_06_uow_rollback_fault_and_restart_preserve_atomic_artifact",
        "tests/integration/db/test_run_06_artifact_persistence.py::test_run_06_artifact_schema_is_portable_and_repository_is_append_only"
      ]
    },
    {
      "id": "transactional-restart-stable-complete-run-timeline",
      "type": "contract",
      "statement": "Attempt reservation, attempt completion, artifact persistence, and Step transition witnesses share the exact mutation unit of work and append to the existing per-Run stream that already carries intake, lifecycle transitions, plan selections, approvals, actions, and receipts. Event identities, foreign keys, timestamps, and bounded metadata remain typed, and committed order is stable across replay and restart.",
      "test_refs": [
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_orch_06_first_start_commits_before_adapter_and_success_completes_later",
        "tests/unit/domain/test_run_06_timeline_contracts.py::test_run_06_factory_issues_exact_reserved_completed_and_artifact_events",
        "tests/unit/domain/test_run_06_timeline_contracts.py::test_run_06_database_contracts_bind_attempts_and_artifacts_without_collision",
        "tests/integration/db/test_run_06_artifact_persistence.py::test_run_06_uow_rollback_fault_and_restart_preserve_atomic_artifact"
      ]
    }
  ],
