  "claims": [
    {
      "id": "postgresql-primary-with-preserved-fallback",
      "type": "contract",
      "statement": "Settings, native startup and Compose select PostgreSQL by default. SQLite remains explicit, existing storage prevents implicit switching, unknown selections fail closed, and required asyncpg installation does not enable network/provider settings.",
      "test_refs": [
        "tests/unit/config/test_arch_01_settings.py",
        "tests/tooling/test_del_05_compose_contract.py",
        "tests/tooling/test_del_10_native_postgresql.py"
      ]
    },
    {
      "id": "private-owned-postgresql-lifecycle",
      "type": "negative_control",
      "statement": "Compose runs a distinct database UID, private peer-authenticated socket and non-superuser app role without an IP network or database publication. Native startup owns a private no-TCP cluster and preserves existing state. Unsafe paths, marker/version drift and implicit adoption fail closed; only owned processes are stopped.",
      "test_refs": [
        "tests/tooling/test_del_05_compose_contract.py",
        "tests/tooling/test_del_10_native_postgresql.py",
        "tests/acceptance/del_10_native_postgresql.py"
      ]
    },
    {
      "id": "postgresql-runtime-and-consistent-projections",
      "type": "journey",
      "statement": "Live PostgreSQL tests require migrations, repeatable seed, all five mock workflows, the two-approval Email barrier, claim fencing and restart identity. Read-only resource projections use transaction-local repeatable-read snapshots; concurrent valid writes cannot mimic corruption, real corruption still fails, and writable transaction isolation is unchanged.",
      "test_refs": [
        "tests/integration/runtime/test_postgresql_primary.py",
        "tests/acceptance/del_10_native_postgresql.py"
      ]
    },
    {
      "id": "paired-postgresql-recovery",
      "type": "journey",
      "statement": "A logical pg_dump and digest key are paired with consistent schema/all-table metadata and checksums. Backup refuses unsafe paths and mismatched identity; restore uses new owned storage and validates the restored pair without overwriting sources. Full owned Compose round-trip and native contracts are mandatory; legacy SQLite recovery remains separately tested.",
      "test_refs": [
        "tests/tooling/test_postgresql_backup.py",
        "tests/acceptance/del_10_native_recovery.py"
      ]
    },
    {
      "id": "full-source-bound-qualification",
      "type": "contract",
      "statement": "The frozen candidate requires all 20 original quality gates and matching audit, complete committed clean-state/backend/frontend/production-browser verification with an added mandatory network-none PostgreSQL suite, native PostgreSQL and explicit SQLite fallback journeys, and both recovery gates. Existing coverage, checks, inventories and deadlines are retained; CI stays disabled.",
      "test_refs": [
        "tests/tooling/test_del_05_clean_state.py",
        "tests/tooling/test_del_01_delivery_entrypoint.py",
        "tests/tooling/test_del_07_local_verification.py"
      ]
    },
    {
      "id": "readonly-dialect-neutral-replay-evidence",
      "type": "negative_control",
      "statement": "Snapshot and scheduler replay checks accept only the owned local database forms, read consistent complete table/schema content without writes, include key identity and alembic state, and retain explicit read-only SQLite support. Row order cannot change a logical digest; unsafe paths, URLs and keys are rejected.",
      "test_refs": [
        "tests/tooling/test_postgresql_primary_smoke.py",
        "tests/integration/runtime/test_postgresql_primary.py"
      ]
    }
  ],
