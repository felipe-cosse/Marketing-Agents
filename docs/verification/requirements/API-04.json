  "claims": [
    {
      "id": "authorized-typed-asynchronous-transport",
      "type": "contract",
      "statement": "POST /api/v1/agent-instances/{instance_id}/dry-runs bounds raw body bytes and JSON depth before framework buffering or recursive parsing, requires an intact server-authenticated human operator at transport and application boundaries, accepts only typed non-authoritative JSON plus an optional bounded opaque retry key, maps dry_run and mock_execute explicitly, and returns a non-cacheable 202 accepted receipt with authoritative work and run identities without executing inline.",
      "test_refs": [
        "tests/integration/api/test_api_04_manual_dry_runs.py::test_api_04_accepts_default_dry_run_and_retains_only_server_authority",
        "tests/integration/api/test_api_04_manual_dry_runs.py::test_api_04_body_is_alias_only_and_cannot_supply_authority",
        "tests/integration/api/test_api_04_manual_dry_runs.py::test_api_04_requires_a_human_operator_before_executor_resolution",
        "tests/integration/api/test_api_04_manual_dry_runs.py::test_api_04_rejects_deep_json_before_recursive_command_normalization",
        "tests/integration/api/test_api_04_manual_dry_runs.py::test_api_04_rejects_raw_body_over_common_limit_even_when_excess_is_whitespace",
        "tests/integration/api/test_api_04_manual_dry_runs.py::test_api_04_rejects_python_equal_but_json_distinct_result_payload",
        "tests/integration/api/test_api_04_manual_dry_runs.py::test_api_04_returns_only_service_sanitized_input_schema_pointers",
        "tests/integration/api/test_api_04_manual_dry_runs.py::test_api_04_openapi_is_exact_typed_and_never_accepts_authority_fields",
        "tests/unit/application/test_api_04_manual_work_intake.py::test_api_04_command_depth_guard_is_iterative_and_stable"
      ]
    },
    {
      "id": "trusted-effective-admission-resolution",
      "type": "negative_control",
      "statement": "The application resolves server-owned trigger and workflow identities from the compiled catalog and one transaction-locked effective instance configuration, validates the exact compiled input schema and template budgets, honors configuration revision and enablement, permits mock execution only under an injected active-mock policy, and rejects unregistered campaign briefs or demo scenarios before receipt.",
      "test_refs": [
        "tests/unit/application/test_api_04_manual_work_intake.py::test_api_04_submit_uses_one_uow_trusted_binding_validator_receipt_and_commit",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_effective_revision_virtual_manual_and_disablement_are_enforced",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_compiled_input_schema_rejects_before_receipt",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_mock_mode_and_unregistered_resource_policies_fail_closed"
      ]
    },
    {
      "id": "durable-idempotent-atomic-receipt",
      "type": "positive",
      "statement": "A caller retry key is transformed into a non-reversible restart-stable event identity; exact and changed simultaneous submissions serialize before their configuration snapshot so an exact retry replays the single original WorkItem and primary Run while semantic drift conflicts, an absent key creates fresh work, and WorkItem, Run, initial transition, and audit are committed or rolled back together.",
      "test_refs": [
        "tests/unit/application/test_api_04_manual_work_intake.py::test_api_04_keyed_event_is_stable_non_reversible_and_absent_key_is_fresh",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_keyed_receipt_replays_after_restart_and_conflicts_on_drift",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_same_key_conflicts_after_effective_configuration_revision_changes",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_concurrent_same_key_serializes_replay_and_changed_conflict",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_fault_after_audit_flush_rolls_back_the_complete_receipt"
      ]
    },
    {
      "id": "ordered-redacted-manual-audit",
      "type": "negative_control",
      "statement": "Every authorized schema-valid manual attempt appends a bounded ingress witness and exactly one created, duplicate-returned, or idempotency-collision outcome to the authoritative Run timeline in the receipt transaction; an authorized schema or bound rejection commits one runless ingress.schema_rejected witness, collision commits no new work or run and records the current attempted trusted routing, and retry keys and payload content are absent from audit metadata and aggregate identities.",
      "test_refs": [
        "tests/unit/application/test_api_04_manual_work_intake.py::test_api_04_schema_rejection_preserves_only_safe_input_pointer",
        "tests/unit/application/test_api_04_manual_work_intake.py::test_api_04_collision_commits_only_a_redacted_authoritative_witness",
        "tests/integration/db/test_api_04_manual_work_audit.py::test_api_04_create_replay_and_collision_append_exact_redacted_timeline",
        "tests/integration/db/test_api_04_manual_work_audit.py::test_api_04_schema_rejection_is_a_runless_atomic_redacted_witness",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_fault_after_audit_flush_rolls_back_the_complete_receipt"
      ]
    },
    {
      "id": "durable-dry-run-external-effect-fence",
