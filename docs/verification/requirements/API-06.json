        "tests/integration/api/test_api_06_approvals.py::test_api_06_read_role_scope_matrix_denies_before_executor",
        "tests/integration/api/test_api_06_approvals.py::test_api_06_missing_identity_is_unauthorized_before_resource_lookup",
