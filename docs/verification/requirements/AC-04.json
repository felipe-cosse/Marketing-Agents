  "claims": [
    {
      "id": "complete-source-hierarchy",
      "type": "journey",
      "statement": "Desktop graph and mobile semantic tree render the real catalog API's ordered one-root, five-department, twelve-function and forty-three-instance hierarchy. Rendered instance identities, template links, ordinals and parents match the source projection; the named orchestrator control plane is excluded from deployment counts.",
      "test_refs": [
        "apps/web/src/features/org-chart/OrgChartCanvas.test.tsx",
        "apps/web/src/features/org-chart/OrgTreeFallback.test.tsx",
        "apps/web/e2e/web-07-responsive-tree.spec.ts"
      ]
    },
    {
      "id": "all-community-deployments-distinct",
      "type": "journey",
      "statement": "All seven canonical Community templates expose their two ordered deployments. Every one of the fourteen cards or tree rows can be selected independently, loads its exact deployment ID and shared template ID through the real detail API, and restores focus on close without an API mutation or hierarchy refetch.",
      "test_refs": [
        "apps/web/src/features/org-chart/OrgChartCanvas.test.tsx",
        "apps/web/src/features/org-chart/OrgTreeFallback.test.tsx",
        "apps/web/e2e/web-07-responsive-tree.spec.ts"
      ]
    },
    {
      "id": "truthful-complete-deployment-copy",
      "type": "negative_control",
      "statement": "Community summaries display full deployed-instance and reusable-template wording, graph chips include the complete Instance ordinal label, and filtered projections derive their actual counts rather than retaining fixed 14/7 copy. Browser geometry checks reject clipped summary/chip text and page overflow at the tested desktop/mobile sizes.",
      "test_refs": [
        "apps/web/src/features/org-chart/presentation.test.ts",
        "apps/web/src/features/org-chart/OrgChartCanvas.test.tsx",
        "apps/web/src/features/org-chart/OrgTreeFallback.test.tsx",
        "apps/web/e2e/web-07-responsive-tree.spec.ts"
      ]
    }
  ],
