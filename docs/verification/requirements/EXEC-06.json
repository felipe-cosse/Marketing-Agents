  "claims": [
    {
      "id": "complete-quality-qualification",
      "type": "contract",
      "statement": "The EXEC-06 command invokes the unchanged complete source-bound AC-16 runner: all 20 gates, complete backend/frontend inventories, 17 safety modules and 16 registered browser runners with existing deadlines. Independently observed successful full execution and its matching external tree-keyed record are both required; local record consistency alone is not execution proof.",
      "test_refs": [
        "tests/tooling/test_exec_06_product_gate.py",
        "tests/integration/db/test_exec_06_schema_validation.py",
        "tests/tooling/test_ac_17_claim_taxonomy.py"
      ]
    },
    {
      "id": "bounded-retention",
      "type": "journey",
      "statement": "Recorded TTLs, bounded legacy registration and fenced atomic maintenance preserve active/recovery material and authenticated non-executable history. Runtime restart preserves old expiry; successful retries permit later erasure. Authorized reads expose no payload or binding material; desktop/mobile timelines remain readable with explicit expiry and no false zero-call inference.",
      "test_refs": [
        "tests/integration/db/test_exec_06_retention.py",
        "tests/integration/db/test_ac_13_cancelled_recovery.py",
        "tests/integration/runtime/test_exec_06_retention_policy.py",
        "tests/integration/api/test_exec_06_retained_details.py",
        "tests/integration/db/test_del_04_migrations.py",
        "tests/unit/application/test_del_07_boundary_replay_guards.py",
        "tests/unit/application/test_exec_06_retained_approval_witnesses.py",
        "tests/integration/scheduler/test_exec_06_retained_receipt_guards.py",
        "tests/integration/db/test_exec_06_retention_retry_history.py",
        "tests/unit/application/test_exec_06_retained_audit_semantics.py",
        "tests/unit/application/test_exec_06_retained_execution_boundaries.py",
        "apps/web/e2e/web-06-runs-artifacts.spec.ts"
      ]
    },
    {
      "id": "local-safe-telemetry",
      "type": "journey",
      "statement": "The actual local API and workers use allowlisted logs and finite process-local metrics without exporters. Audit observations publish after outer commit only, redaction observes actual masks, and safe server diagnostics exclude raw exceptions. Real runtime canaries exercise approval dwell, scheduler lag, duplicates, connector outcomes, rollback and audit failures.",
      "test_refs": [
        "tests/unit/observability/test_exec_06_telemetry.py",
        "tests/integration/security/test_exec_06_observability.py"
      ]
    },
    {
      "id": "demo-and-local-tooling",
      "type": "contract",
      "statement": "Five documented fixed synthetic demo recipes and a bounded mock/offline CLI retain approval restrictions. The useful clean-export fixes quiesce only owned processes during isolated suites, restore them before browser readiness, and emit bounded sanitized diagnostics without changing checks or deadlines. CI remains disabled and checkpoint branches are retained.",
      "test_refs": [
        "tests/tooling/test_exec_06_demo_docs.py",
        "tests/tooling/test_del_05_clean_state.py",
        "tests/tooling/test_del_05_offline_diagnostics.py"
      ]
    }
