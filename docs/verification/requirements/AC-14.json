  "claims": [
    {
      "id": "complete-business-audit-public-joins",
      "type": "journey",
      "statement": "Real READ completion and Email approval, rejection and renewal journeys independently join persisted Run/Step transitions, approval requests/decisions/uses and execution evidence to exact durable audits, then to paginated public timelines and feeds across runtime reconstruction.",
      "test_refs": [
        "tests/acceptance/test_ac_14_audit_timeline.py"
      ]
    },
    {
      "id": "public-command-audit-rollback",
      "type": "negative_control",
      "statement": "First/final approval and queued/prebarrier/released cancellation roll back all persisted tables and both audit allocators when an already-flushed audit fails. The same public command then succeeds once with dense sequences, matching mutation facts and no connector calls.",
      "test_refs": [
        "tests/acceptance/test_ac_14_audit_rollback.py"
      ]
    },
    {
      "id": "unexpected-worker-cleanup-audited",
      "type": "journey",
      "statement": "Unexpected execution failure through the default worker atomically appends cleanup audits alongside failed Run/Step and cancelled action mutations. Post-flush audit failure rolls back cleanup and sequence allocation; retry preserves consumed approval authority and produces one audited terminal outcome.",
      "test_refs": [
        "tests/acceptance/test_ac_14_worker_failure_audit.py"
      ]
    },
    {
      "id": "stable-public-order-and-expired-skeleton",
      "type": "contract",
      "statement": "Equal-timestamp public audit pages use fixed feed watermarks across genuine appends and reject changed cursor filters. At exact metadata expiry, reconstruction preserves every event and all nonmetadata projection fields, including transition/approval identity, actor, correlation, state and links.",
      "test_refs": [
        "tests/acceptance/test_ac_14_audit_projection.py"
      ]
    }
  ],
