  "claims": [
    {
      "id": "atomic-on-time-advance",
      "type": "contract",
      "statement": "One exact active claim is fenced and consumed in one processing unit of work that atomically persists the stable enqueued occurrence, normal WorkItem and primary Run receipt, initial transition and receipt audit, scheduler audit witnesses, consumed due time, planned next UTC occurrence, one schedule version increment, and complete lease release through a final integrity-sealed compare-and-swap.",
      "test_refs": [
        "tests/integration/scheduler/test_sched_05_occurrence_transaction.py::test_sched_05_on_time_outcome_advances_and_releases_in_one_commit",
        "tests/integration/scheduler/test_sched_05_occurrence_transaction.py::test_sched_05_schema_has_portable_advance_and_misfire_constraints"
      ]
    },
    {
      "id": "atomic-skip-without-work",
      "type": "negative_control",
      "statement": "A skip misfire commits one terminal occurrence anchored to the original due instant with exact bounded policy, grace, evaluation, first, last, and count facts; creates no WorkItem, Run, or transition; advances to the plan's first future recurrence; emits globally ordered non-Run audit witnesses; and releases the lease in the same commit.",
      "test_refs": [
        "tests/integration/scheduler/test_sched_05_occurrence_transaction.py::test_sched_05_skip_persists_exact_missed_range_without_work",
        "tests/integration/scheduler/test_sched_05_occurrence_transaction.py::test_sched_05_schema_has_portable_advance_and_misfire_constraints"
      ]
    },
    {
      "id": "atomic-run-once-coalescing",
      "type": "contract",
      "statement": "A run_once misfire retains the complete bounded missed range on one stable occurrence and admits exactly one WorkItem and primary Run rather than a backlog, while the same transaction persists scheduler audits, the first planned future recurrence, version advancement, and lease release.",
      "test_refs": [
        "tests/integration/scheduler/test_sched_05_occurrence_transaction.py::test_sched_05_run_once_coalesces_range_to_exactly_one_receipt"
      ]
    },
    {
      "id": "fault-rollback-preserves-claim",
      "type": "negative_control",
      "statement": "Injected failure after all intended processing rows and recurrence advancement are visible but before the sole commit rolls back every occurrence, WorkItem, Run, transition, processing audit, last-time, next-time, version, and release mutation, leaving the separately committed original due claim byte-for-byte authoritative for later recovery.",
      "test_refs": [
