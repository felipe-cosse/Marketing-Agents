  "claims": [
    {
      "id": "authoritative-all-state-cancellation-routing",
      "type": "contract",
      "statement": "One application coordinator derives the current Run state, version, plan effect, and authoritative cancellation service. It accepts every nonterminal phase, bounds only typed routing races, normalizes lower-layer failures, and records one stable audited rejection for terminal retries.",
      "test_refs": [
        "tests/integration/db/test_run_03_cancellation_coordinator.py::test_run_03_early_run_routes_through_audited_lifecycle",
        "tests/integration/db/test_run_03_cancellation_coordinator.py::test_run_03_controlled_read_routes_planned_or_executing_run",
        "tests/integration/db/test_run_03_cancellation_coordinator.py::test_run_03_write_routes_pre_or_post_release_approval_boundary",
        "tests/integration/db/test_run_03_cancellation_coordinator.py::test_run_03_terminal_rejection_is_audited_and_stable"
      ]
    },
    {
      "id": "atomic-fence-and-zero-future-call",
      "type": "negative_control",
      "statement": "Cancellation commits its execution-control fence before closing queued work. Completed READ retry backoff and pre-call WRITE retry generations close atomically, while correlated Run and control predicates prevent stale recovery from re-arming an action after cancellation wins.",
      "test_refs": [
        "tests/integration/db/test_run_03_retry_cleanup.py::test_run_03_direct_cancel_closes_read_retry_backoff_before_restart",
        "tests/integration/db/test_run_03_retry_cleanup.py::test_run_03_released_cancel_closes_provider_retry_write_step",
        "tests/integration/db/test_run_03_retry_cleanup.py::test_run_03_cancellation_fence_prevents_stale_provider_retry_rearm"
      ]
    },
    {
      "id": "best-effort-inflight-outcome-honesty",
      "type": "contract",
      "statement": "A genuinely call-started WRITE remains bounded after Run cancellation. Its exact durable success, known failure, or outcome-unknown conclusion atomically terminalizes the WRITE step and appends the action outcome before the step event without rewriting the cancelled Run.",
      "test_refs": [
        "tests/integration/db/test_run_03_write_completion.py::test_run_03_post_cancel_timely_provider_success_closes_write_step",
        "tests/integration/db/test_run_03_write_completion.py::test_run_03_terminal_provider_failure_closes_write_step_atomically",
        "tests/integration/db/test_run_03_write_completion.py::test_run_03_completion_audit_fault_rolls_back_action_and_step_then_recovers_receipt"
      ]
    },
    {
      "id": "ordered-effect-aware-cancellation-timeline",
      "type": "negative_control",
      "statement": "Actions already succeeded or outcome-unknown before cancellation remain immutable and are never represented as cancelled. Their events retain order around the Run cancellation event, transition history records cancellation-time effect counts, and audit faults roll back action and step completion together.",
      "test_refs": [
        "tests/integration/db/test_run_03_write_completion.py::test_run_03_preexisting_success_remains_immutable_and_precedes_cancellation",
        "tests/integration/db/test_run_03_write_completion.py::test_run_03_terminal_provider_failure_closes_write_step_atomically",
        "tests/integration/db/test_run_03_write_completion.py::test_run_03_post_cancel_timely_provider_success_closes_write_step",
        "tests/integration/db/test_run_03_write_completion.py::test_run_03_completion_audit_fault_rolls_back_action_and_step_then_recovers_receipt"
      ]
    }
