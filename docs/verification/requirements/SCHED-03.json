  "claims": [
    {
      "id": "versioned-stable-occurrence-identity",
      "type": "contract",
      "statement": "A domain-separated canonical SHA-256 occurrence ID derives only from the exact schedule ID, persisted scheduled UTC instant, and persisted recurrence-semantics version. Worker, claim time, expiry, fencing version, processing time, routing, and payload do not affect it; changed schedule, due instant, or recurrence version changes it, while the local timezone representation and fold remain a separate durable snapshot.",
      "test_refs": [
        "tests/unit/scheduler/test_sched_03_occurrence_identity.py::test_sched_03_occurrence_id_has_a_fixed_known_vector",
        "tests/unit/scheduler/test_sched_03_occurrence_identity.py::test_sched_03_occurrence_id_ignores_claim_worker_and_restart_facts",
        "tests/unit/scheduler/test_sched_03_occurrence_identity.py::test_sched_03_occurrence_id_changes_with_each_immutable_identity_fact",
        "tests/unit/scheduler/test_sched_03_occurrence_identity.py::test_sched_03_local_snapshot_records_which_fall_back_instant_was_chosen",
        "tests/unit/scheduler/test_sched_03_occurrence_identity.py::test_sched_03_occurrence_rejects_a_false_local_or_fold_snapshot",
        "tests/unit/scheduler/test_sched_03_occurrence_identity.py::test_sched_03_occurrence_id_rejects_invalid_identity_inputs"
      ]
    },
    {
      "id": "constraint-backed-occurrence-replay",
      "type": "negative_control",
      "statement": "Each occurrence is sealed and constrained by primary occurrence ID, unique schedule and due instant, unique complete WorkItem and Run links, restrictive foreign keys, supported fold and state tuples, and a full-row consistency digest. Exact committed replay returns the authoritative occurrence across engine restart; changed immutable snapshots, another ID for the same due instant, and unrecomputed row drift fail closed.",
      "test_refs": [
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_occurrence_event_creates_one_atomic_run_receipt_and_restarts",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_occurrence_id_and_schedule_due_constraints_reject_conflicts",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_repository_rejects_a_run_from_another_work_item",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_occurrence_digest_drift_fails_hydration",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_occurrence_schema_has_portable_identity_and_receipt_constraints"
      ]
    },
    {
      "id": "occurrence-event-id-run-idempotency",
      "type": "contract",
      "statement": "Production schedule ingress fences one exact active claim, hard-sets source schedule and derived occurrence event_id, copies routing only from the persisted schedule, validates the envelope, and creates or replays occurrence, WorkItem, primary Run, transition, and audit in one transaction. Exact expiry remains active; stale, replaced, or expired claims, changed payload, mixed dispositions, a mismatched Run/Work pair, and a post-receipt fault cannot commit a duplicate or partial receipt.",
      "test_refs": [
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_occurrence_event_creates_one_atomic_run_receipt_and_restarts",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_changed_payload_collides_without_duplicate_receipt",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_invalid_claim_fails_before_any_receipt_mutation",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_claim_remains_processable_at_exact_expiry",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_claim_expiring_during_fence_rolls_back_before_receipt",
        "tests/integration/scheduler/test_sched_03_occurrence_ingress.py::test_sched_03_post_receipt_link_fault_rolls_back_every_new_row"
      ]
    }
  ],
