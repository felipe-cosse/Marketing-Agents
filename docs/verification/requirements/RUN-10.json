  "claims": [
    {
      "id": "server-derived-immutable-principal",
      "type": "negative_control",
      "statement": "Approval identity is an integrity-checked immutable principal issued behind the infrastructure adapter boundary; the settings-bound local provider snapshots one fixed human actor and fixed grants only in validated local non-production loopback configuration, rejects bearer credentials, and keeps bearer evidence out of representations and safe snapshots.",
      "test_refs": [
        "tests/unit/application/test_run_10_authorized_approval_actor.py::test_run_10_principal_is_adapter_issued_immutable_and_secret_evidence_is_hidden",
        "tests/unit/application/test_run_10_authorized_approval_actor.py::test_run_10_principal_issuer_stays_behind_the_infrastructure_boundary",
        "tests/unit/application/test_run_10_authorized_approval_actor.py::test_run_10_local_provider_snapshots_settings_and_refuses_bearer",
        "tests/integration/api/test_run_10_identity_dependency.py::test_run_10_default_local_identity_is_fixed_and_bearer_is_not_a_fallback"
      ]
    },
    {
      "id": "narrow-transport-and-all-of-authorization",
      "type": "negative_control",
      "statement": "Real approve/reject routes derive the exact principal and decision path server-side, accept an extra-forbid generation/payload-hash/reason DTO, generate correlation, sanitize bounded validation and service errors, and require a HUMAN, global approver role, approvals:decide scope, every persisted-policy grant, and the self-approval rule without admin shortcuts.",
      "test_refs": [
        "tests/integration/api/test_run_10_approval_routes.py::test_run_10_real_route_uses_local_actor_and_returns_only_resource_state",
        "tests/integration/api/test_run_10_approval_routes.py::test_run_10_route_role_matrix_denies_before_executor",
        "tests/integration/api/test_run_10_approval_routes.py::test_run_10_route_missing_identity_is_unauthorized_before_executor",
        "tests/integration/api/test_run_10_approval_routes.py::test_run_10_forged_body_authority_and_decision_never_reach_executor",
        "tests/integration/api/test_run_10_approval_routes.py::test_run_10_spoofed_header_and_oversized_reason_fail_without_secret_echo",
        "tests/integration/api/test_run_10_approval_routes.py::test_run_10_route_rejects_executor_result_that_disagrees_with_fixed_path",
        "tests/integration/api/test_run_10_approval_routes.py::test_run_10_route_maps_service_errors_without_sensitive_detail",
        "tests/integration/api/test_run_10_approval_routes.py::test_run_10_real_service_rechecks_stored_policy_after_route_guard",
        "tests/integration/api/test_run_10_identity_dependency.py::test_run_10_spoofed_identity_and_forwarded_headers_fail_before_provider",
        "tests/integration/api/test_run_10_identity_dependency.py::test_run_10_non_identity_proxy_headers_remain_api_09_scope",
        "tests/unit/application/test_run_10_authorized_approval_actor.py::test_run_10_authority_requires_human_and_all_baseline_and_policy_grants"
      ]
    },
    {
      "id": "atomic-one-winner-authorized-decision",
      "type": "contract",
      "statement": "The decision service accepts an already authenticated exact principal, authorizes baseline grants before lookup, reauthorizes the stored policy, validates the unique current request leaf and exact action hash, derives actor, minimum matched grants, action version, ID, reason code, and UTC time, then gives concurrent approve/reject attempts one winner without granting reservation or connector authority.",
      "test_refs": [
        "tests/unit/application/test_run_10_authorized_approval_actor.py::test_run_10_baseline_denial_happens_before_clock_id_or_repository_access",
        "tests/integration/db/test_run_10_authorized_approval_decisions.py::test_run_10_preconditions_fail_without_decision_or_audit_mutation",
        "tests/integration/db/test_run_10_authorized_approval_decisions.py::test_run_10_concurrent_approve_reject_has_one_decision_and_one_audit_pair",
        "tests/integration/db/test_run_10_authorized_approval_decisions.py::test_run_10_renewed_leaf_decides_at_action_version_five_and_old_leaf_fails"
      ]
    },
    {
      "id": "same-uow-linked-decision-witnesses",
      "type": "contract",
      "statement": "Each winning decision atomically persists its request and action CAS plus typed action and approval audit witnesses linked directly to the same decision and request; authenticated audit provenance is derived from that principal, audit failure rolls back all facts, hydration and proposal drift fail closed, and replay does not heal missing audit history.",
