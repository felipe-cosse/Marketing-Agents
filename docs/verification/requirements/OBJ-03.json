  "claims": [
    {
      "id": "shared-executable-catalog-contracts",
      "type": "contract",
      "statement": "Manual, webhook and schedule resolution and the worker share immutable schema- and catalog-bound executable definitions for 36 templates and 43 instances. Unknown identities, unsupported modes, schema aliases and drift fail closed; the five existing demo contracts retain their original hashes and handlers.",
      "test_refs": [
        "tests/unit/application/test_obj_03_executable_workflows.py"
      ]
    },
    {
      "id": "role-specific-read-simulation",
      "type": "positive",
      "statement": "All 37 read-role instances complete actual API admission and restarted-worker dry runs under their own catalog contracts: 31 use the deterministic mock model adapter and six use authorized local transforms. Role outputs use supplied business evidence, retain advisory restrictions and budgets, and do not invent absent metrics or dispatch generated proposals.",
      "test_refs": [
        "tests/contract/test_obj_03_catalog_roles.py",
        "tests/integration/runtime/test_obj_03_catalog_workflows.py"
      ]
    },
    {
      "id": "write-role-dry-runs-have-no-authority",
      "type": "negative_control",
      "statement": "The six write-only instances across four roles produce explicitly labeled typed proposal documents in DRY_RUN. Their real catalog WRITE capability is described by a reserved planner-output NO_CALL step, not executed or replaced with a model/artifact capability. Plan, persistence and execution reject real-execution mode or connector/approval authority; no calls, actions, approvals or receipts are created.",
      "test_refs": [
        "tests/unit/application/test_obj_03_preview_planning.py",
        "tests/unit/application/test_obj_03_planner_preview.py",
        "tests/integration/db/test_obj_03_planner_preview_constraints.py",
        "tests/integration/runtime/test_obj_03_proposal_previews.py"
      ]
    },
    {
      "id": "explicit-approved-mock-writes",
      "type": "positive",
      "statement": "In explicit mock execution, all six write-only instances accept only versioned typed operator commands, wait for the exact independent approval and complete through the controlled connector dispatcher. Durable receipts and one tool call prove the local mock action; catalog result artifacts are not fabricated. Restart, rejection, cancellation, stale snapshots, definition drift and retry ceilings remain guarded.",
      "test_refs": [
        "tests/integration/runtime/test_obj_03_catalog_writes.py"
      ]
    },
    {
      "id": "explicit-signed-scheduled-input",
      "type": "contract",
      "statement": "Installation-keyed input binding covers the exact instance, workflow definition, input schema, key version, dry_run mode and payload. Separate atomic configuration-revision and claim fences keep schedule synchronization and redacted audit consistent, reject altered bindings and make stale claims no-ops. Due occurrences retain explicit input through restarted-worker completion. Schedules are dry_run-only; legacy schedules without explicit input stay readable but do not execute.",
      "test_refs": [
        "tests/integration/scheduler/test_obj_03_configuration_binding.py",
        "tests/integration/runtime/test_obj_03_scheduler_liveness.py",
        "tests/integration/runtime/test_obj_03_catalog_workflows.py",
        "tests/integration/api/test_api_03_instance_configuration.py"
      ]
    },
    {
      "id": "restricted-schema-bound-configuration-editor",
      "type": "journey",
      "statement": "The administrator-only editor loads the restricted current configuration and revision, renders schema-bound scheduled input, requires explicit valid input to enable a dry_run-only schedule, preserves drafts, and exposes storage semantics. Field identifiers remain stable for nested editors. Unit contracts cover the new input path; the WEB-03 browser gate protects existing inspector, revision, conflict and layout behavior.",
      "test_refs": [
        "apps/web/src/features/instance-detail/InstanceConfigurationEditor.test.tsx",
        "apps/web/src/api/instanceConfiguration.test.ts",
        "apps/web/src/features/dry-run/SchemaForm.test.tsx",
        "apps/web/e2e/web-03-agent-details.spec.ts"
      ]
    },
    {
      "id": "atomic-no-call-output-and-replay",
      "type": "negative_control",
      "statement": "Local artifacts commit their schema-bound provenance, successful step and distinct audit event in one real SQLite transaction with zero attempts, operation policies, rate windows or call counters. Restart and concurrent completion reuse one output; cancellation fences and schema, byte, exact-deadline, renderer, late-CAS and audit failures preserve every prior row. Preview audit additionally requires its exact planner provider.",
      "test_refs": [
        "tests/integration/runtime/test_obj_03_local_artifacts.py",
        "tests/integration/runtime/test_obj_03_proposal_previews.py",
        "tests/unit/application/test_obj_03_planner_preview.py",
        "tests/integration/db/test_obj_03_planner_preview_constraints.py"
      ]
    },
    {
      "id": "populated-failure-safe-schema-upgrades",
      "type": "negative_control",
      "statement": "Frozen 0007/0008 upgrades preserve legacy schedule/configuration integrity and populated linked runs, steps, artifacts, approvals, actions, receipts, audit ordering and row versions. SQLite copy/drop faults and a final foreign-key violation after rebuild/revision advance restore the exact prior data, schema, indexes and revision, with foreign_keys enabled on the same reused connection. Repeated upgrades are inert.",
      "test_refs": [
        "tests/integration/db/test_obj_03_artifact_migration.py",
        "tests/integration/db/test_del_04_migrations.py",
        "tests/integration/scheduler/test_obj_03_configuration_binding.py"
      ]
    },
    {
      "id": "contract-and-layer-regression-controls",
      "type": "contract",
      "statement": "Generated contracts describe restricted configuration; architecture checks retain layer direction and frontend API ownership. Existing demo and budget tests retain workflow behavior and NO_CALL accounting. The verification-only replay fixture uses explicitly bound dry-run input and the registered workflow, preserving zero-write reseed and occurrence identity across restart.",
      "test_refs": [
        "tests/integration/runtime/test_del_05_process_composition.py",
        "tests/tooling/test_del_05_clean_state_fixture.py",
        "tests/unit/application/test_orch_06_planning_budgets.py",
        "apps/web/src/api/agentInstanceDetail.test.ts"
      ]
    }
  ],
