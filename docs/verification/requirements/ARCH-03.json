  "claims": [
    {
      "id": "portable-sqlite-runtime",
      "type": "contract",
      "statement": "The default async SQLite runtime applies foreign-key, WAL, and bounded busy-timeout policy per connection, normalizes aware timestamps to UTC, and provides an explicit repository-injected transaction boundary.",
      "test_refs": [
        "tests/integration/db/test_arch_03_portable_database.py::test_arch_03_sqlite_runtime_enforces_pragmas_and_aware_utc",
        "tests/integration/db/test_arch_03_portable_database.py::test_arch_03_repository_injected_unit_of_work_commits_or_rolls_back",
        "tests/integration/db/test_arch_03_portable_database.py::test_arch_03_base_exposes_portable_naming_convention"
      ]
    },
    {
      "id": "configurable-lazy-postgresql",
      "type": "negative_control",
      "statement": "Only the exact asynchronous SQLite and PostgreSQL drivers are accepted, database credentials and query values are absent from diagnostics, and PostgreSQL engine construction performs no connection or fallback.",
      "test_refs": [
        "tests/integration/db/test_arch_03_portable_database.py::test_arch_03_postgresql_driver_is_lazy_and_safe_without_network",
        "tests/integration/db/test_arch_03_portable_database.py::test_arch_03_rejects_sync_unsupported_and_network_sqlite_urls"
      ]
    }
  ],
  "gates": [
    {
      "id": "arch-03-portable-database",
      "runner": "argv",
      "argv": [
        "uv",
        "run",
        "--extra",
        "postgresql",
        "pytest",
        "-q",
        "--disable-socket",
        "--allow-unix-socket",
