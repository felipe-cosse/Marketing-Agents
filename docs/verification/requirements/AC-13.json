  "claims": [
    {
      "id": "public-operator-cancellation",
      "type": "contract",
      "statement": "The strict empty-JSON cancellation route and application wrapper independently enforce server-issued human operator authority, browser security, bounded input and execution, fixed safe errors, and explicit cancellation-time snapshot semantics.",
      "test_refs": [
        "tests/integration/api/test_ac_13_cancellation_api.py"
      ]
    },
    {
      "id": "queued-and-pre-barrier-zero-calls",
      "type": "journey",
      "statement": "Public cancellation of queued and not-fully-approved Email runs persists cancellation across reconstruction, executes no connector, and consumes or reserves no approval authority; terminal repeat requests conflict and remain auditable.",
      "test_refs": [
        "tests/acceptance/test_ac_13_public_cancellation.py"
      ]
    },
    {
      "id": "inflight-effects-remain-truthful",
      "type": "journey",
      "statement": "A real mock receipt and previously completed effects remain authoritative after public cancellation. Timely completion records success, uncalled siblings are cancelled, consumed approvals and exact immutable action identities are preserved, and the ordered public timeline makes no rollback claim.",
      "test_refs": [
        "tests/acceptance/test_ac_13_public_cancellation.py"
      ]
    },
    {
      "id": "cancelled-restart-recovery-without-replay",
      "type": "journey",
      "statement": "Default worker reconstruction selects only due unfinished evidence under cancelled parents. It reconciles an exact WRITE receipt or records outcome unknown when absent, and closes expired READ attempts without new calls, artifacts, retries or budget reservations; parent cancellation and completed siblings remain immutable.",
      "test_refs": [
        "tests/acceptance/test_ac_13_public_cancellation.py",
        "tests/integration/db/test_ac_13_cancelled_recovery.py"
      ]
    },
    {
      "id": "recovery-fences-and-integrity",
      "type": "negative_control",
      "statement": "Exact plan/control, attempt/action and claim fences reject the tested corrupt or stale recovery authority. Before-deadline recovery is inert; concurrent claims, competing completion and repeated recovery cannot duplicate outcomes, audit mutations or effects. A lost worker claim cannot mutate or audit closure.",
      "test_refs": [
        "tests/integration/db/test_ac_13_cancelled_recovery.py"
      ]
    }
  ],
