  "claims": [
    {
      "id": "explicit-neutral-connector-bindings",
      "type": "contract",
      "statement": "Controlled READ and authorized WRITE bridges resolve explicit immutable binding registrations rather than concrete mock family attributes. Same-family implementations remain independently selectable and READ provenance comes from registered provider metadata. The mock composition preserves its existing provenance and offline defaults.",
      "test_refs": ["tests/contract/test_obj_05_connector_bindings.py", "scripts/verify_obj_05_boundaries.py"]
    },
    {
      "id": "fail-closed-extension-contracts",
      "type": "negative_control",
      "statement": "Extension boundaries reject duplicate or incompatible bindings, unavailable or non-async operations, mismatched registry identities, invalid revisions and non-durable WRITE bindings before provider calls. Catalog validation rejects changes to exact application-owned v1 request/result DTOs and method declarations, even when schema labels and metadata still match.",
      "test_refs": ["tests/contract/test_obj_05_connector_bindings.py"]
    },
    {
      "id": "independent-adapters-through-core",
      "type": "journey",
      "statement": "Independent offline model and newsletter implementations run through the existing application services and RunWorker without changes to application/domain code. Structured model output is independently validated; approved writes require dispatcher authorization and persisted receipts, with reconstructed runtime replay retaining the original effect identity.",
      "test_refs": ["tests/integration/runtime/test_obj_05_adapter_substitution.py"]
    },
    {
      "id": "substitution-preserves-safety",
      "type": "negative_control",
      "statement": "Independent adapter substitution does not turn malformed model output into an artifact or bypass absent approval and post-approval binding-configuration drift. Static bridge controls reject concrete implementation dependencies and hard-coded provider identity; repository layer checks and existing mock/authorization contracts remain mandatory regression gates.",
      "test_refs": ["tests/integration/runtime/test_obj_05_adapter_substitution.py", "tests/tooling/test_obj_05_boundaries.py"]
    }
  ],
