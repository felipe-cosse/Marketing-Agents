  "claims": [
    {
      "id": "stable-seven-field-action-key",
      "type": "contract",
      "statement": "Every planned write derives one domain-separated restart-stable key from the complete seven-field semantic material, persists it with the immutable exact action, and passes that same key through authorization to the connector.",
      "test_refs": [
        "tests/unit/domain/test_run_05_action_idempotency.py::test_run_05_key_is_domain_separated_restart_stable_and_golden",
        "tests/unit/domain/test_run_05_action_idempotency.py::test_run_05_every_stable_material_field_changes_the_key",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_three_phase_dispatch_commits_one_receipt_and_replays_after_restart"
      ]
    },
    {
      "id": "atomic-authoritative-action-set",
      "type": "contract",
      "statement": "A multi-write proposal epoch is inserted atomically in stable step order or replayed as its authoritative original identities; concurrent, partial, changed, and caller-rollback cases never create a mixed or partial set.",
      "test_refs": [
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_atomic_set_replay_returns_original_exact_identity_after_restart",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_set_registration_race_is_all_created_or_authoritative_replay",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_outer_rollback_removes_the_entire_registered_set",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_preexisting_partial_set_fails_closed_without_filling_members"
      ]
    },
    {
      "id": "durable-receipt-and-three-phase-dispatch",
      "type": "positive",
      "statement": "The dispatcher commits claim and call-start fences before invoking a durable connector ledger outside its transaction, then completes only from the exact persisted receipt; concurrent workers and restarts produce one effect and one receipt.",
      "test_refs": [
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_two_dispatch_workers_make_exactly_one_connector_call",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_connector_await_has_no_dispatcher_transaction_open",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_completion_uses_authoritative_receipt_metadata",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_durable_receipt_race_restart_and_collision_guards",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_receipt_replay_requires_exact_result_projection"
      ]
    },
    {
      "id": "bounded-classified-recovery-no-blind-retry",
      "type": "negative_control",
      "statement": "Recovery is bounded by an absolute ten-attempt persisted limit, reconciles exact durable receipts before retry or unknown classification, retries only proven provider-idempotent calls with the same key, and never blindly retries unavailable providers.",
      "test_refs": [
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_attempt_bound_is_enforced_by_domain_and_database",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_final_attempt_lost_response_reconciles_durable_receipt",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_stale_crash_after_receipt_reconciles_without_provider_call",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_exhausted_pre_call_claim_fails_without_connector_call",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_unavailable_post_call_stale_never_blind_retries",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_stale_attempt_cannot_overwrite_new_lease_generation",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_cancelled_parent_blocks_claim_and_pre_call_marker"
      ]
    },
    {
      "id": "fail-closed-redacted-dispatch-boundary",
      "type": "negative_control",
      "statement": "Dispatch rejects process-local receipt ledgers, persistence identity drift, reservation rewrites, and raw connector failures before another effect; safe failures suppress provider payload and exception causes across completion faults.",
      "test_refs": [
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_dispatch_gateway_rejects_process_local_receipt_ledger",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_gateway_suppresses_validation_and_provider_secret_causes",
