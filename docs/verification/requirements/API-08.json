  "claims": [
    {
      "id": "canonical-offline-schema-policy",
      "type": "contract",
      "statement": "One fail-closed policy canonicalizes and freezes object-shaped Draft 2020-12 schemas, enforces that dialect in actual nested subschemas, binds optional IDs, supports only resolvable local $ref and $dynamicRef pointers or anchors, rejects duplicate anchors and legacy recursive keywords, preserves reference-shaped annotation/default data, and emits deterministic non-reflective pointers without retaining rejected values.",
      "test_refs": [
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_compilation_canonicalizes_and_freezes_an_independent_snapshot",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_optional_embedded_id_may_be_absent_but_must_match_when_present",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_nonlocal_schema_references_are_rejected",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_unresolved_local_references_fail_during_compilation",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_local_references_and_format_checks_are_enforced",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_local_anchors_and_nested_resources_resolve_at_compile_time",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_duplicate_anchors_in_one_resource_are_rejected",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_reference_shaped_example_data_is_not_treated_as_a_schema_reference",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_invalid_dialect_and_schema_definition_fail_during_compilation",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_nested_schema_cannot_switch_to_an_unsupported_dialect",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_legacy_recursive_keywords_are_rejected_in_actual_subschemas",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_error_selection_and_pointers_are_deterministic_and_non_reflective",
        "tests/unit/application/test_api_08_json_schema_policy.py::test_api_08_depth_limit_is_inclusive_and_rejects_limit_plus_one",
