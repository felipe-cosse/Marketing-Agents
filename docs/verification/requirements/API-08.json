        "tests/contract/test_arch_06_llm_provider.py::test_api_08_real_response_requires_exact_canonical_llm_response",
        "tests/contract/test_arch_06_llm_provider.py::test_api_08_non_complete_response_fails_before_payload_schema_validation",
        "tests/contract/test_arch_06_llm_provider.py::test_api_08_response_is_canonical_detached_data_and_schema_snapshot_cannot_drift"
      ]
    },
    {
      "id": "validated-write-response-with-ambiguous-effect",
      "type": "negative_control",
      "statement": "The registered WRITE gateway reconstructs the exact authorized request DTO before calling a connector and reconstructs and schema-validates an exact canonical ConnectorWriteResult afterward. A malformed result or ordinary post-call response-normalization exception is classified schema_invalid_response with request_may_have_left_process true, so the dispatcher cannot record false success or corrupt the action result and recovery uses the authoritative receipt.",
      "test_refs": [
