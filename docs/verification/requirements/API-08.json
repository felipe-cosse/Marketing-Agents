    {
      "id": "independently-validated-llm-boundary",
      "type": "contract",
      "statement": "Deterministic and explicitly selected real LLM adapters accept only exact canonical typed requests, bind the declared output schema ID and hash before provider access, retain an immutable preflight snapshot, and reconstruct exact complete responses before checking schema, byte/token bounds, and provider identity. Renderer or delegate mutation cannot weaken trusted bounds, and renderer failures are context-free and non-reflective.",
      "test_refs": [
