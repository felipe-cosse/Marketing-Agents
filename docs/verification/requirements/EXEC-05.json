  "claims": [
    {
      "id": "complete-product-qualification",
      "type": "contract",
      "statement": "The EXEC-05 command reuses the complete source-bound AC-16 quality wrapper: all 20 gates, full backend and frontend inventories, 17-module safety coverage and 16 registered browser runners, with existing deadlines and no selectors. Qualification requires independently observed successful execution and its matching tree-keyed record; control tests and record consistency alone are not execution proof.",
      "test_refs": [
        "tests/tooling/test_exec_05_product_gate.py"
      ]
    },
    {
      "id": "configuration-owned-schedules",
      "type": "journey",
      "statement": "Seven dedicated schedule routes use existing configuration authorization, CAS, input binding and atomic schedule/audit synchronization. Real HTTP/SQLite/runtime tests cover restart, retained disable/enable history, concurrent revision conflicts, actual worker occurrence identity, bounded pagination, privacy and malformed transport. These routes do not create a second scheduler or bypass admission.",
      "test_refs": [
        "tests/integration/api/test_exec_05_schedule_control.py"
      ]
    },
    {
      "id": "standalone-immutable-briefs",
      "type": "journey",
      "statement": "Standalone brief create/read routes provide immutable installation-keyed retries, restricted input with separate redacted expiring projection, human authorization and atomic creation audit. Tests cover replay/collision, concurrent retries, expiry, tampering, rollback and populated migration preservation. No shipped workflow is allowed to consume a brief.",
      "test_refs": [
        "tests/integration/db/test_exec_05_campaign_briefs.py",
        "tests/integration/db/test_del_04_migrations.py",
        "tests/integration/db/test_ac_12_recurrence_persistence.py"
      ]
    },
    {
      "id": "generated-contract-control-surface",
      "type": "journey",
      "statement": "Generated OpenAPI types own client response models without replacing runtime validation or reversing pure-contract dependency direction. The real desktop/mobile browser journey joins a persisted run through Runs & audit to its paginated timeline and artifact, comparing rendered events with public API projections. Existing complete browser/demo gates remain required.",
      "test_refs": [
        "apps/web/src/api/apiContract.test.ts",
        "apps/web/e2e/obj-06-control-surface.spec.ts"
      ]
    }
  ],
