  "claims": [
    {
      "id": "sealed-planning-policy-and-logical-budgets",
      "type": "contract",
      "statement": "Trusted catalog policies are frozen into Run and Step snapshots, and every effective policy and adapter-contract field is plan-hash-bound. Template and Run logical budgets fail before execution authority, while persistence independently rejects inflated or incomplete operation sets.",
      "test_refs": [
        "tests/unit/domain/test_orch_06_runtime_policy.py::test_orch_06_policy_projections_are_frozen_canonical_and_complete",
        "tests/unit/domain/test_orch_06_runtime_policy.py::test_orch_06_every_policy_field_is_semantically_hash_bound",
