      "type": "negative_control",
      "statement": "Plan persistence atomically installs HMAC-protected controls and operations. Attempt reservations atomically consume the correct logical-call budget and fixed-window capacity, with exact boundaries, one-winner races, rollback, sanitized contention, and fail-closed tamper detection.",
      "test_refs": [
        "tests/integration/db/test_orch_06_runtime_composition.py::test_orch_06_plan_creation_installs_exact_control_and_replay_is_a_noop",
        "tests/integration/db/test_orch_06_runtime_composition.py::test_orch_06_plan_creation_fault_rolls_back_plan_and_control",
        "tests/integration/db/test_orch_06_execution_control.py::test_orch_06_schema_compiles_with_portable_attempt_and_capacity_fences",
        "tests/integration/db/test_orch_06_execution_control.py::test_orch_06_reservation_commits_before_call_and_completion_is_separate",
        "tests/integration/db/test_orch_06_execution_control.py::test_orch_06_fixed_window_denial_is_atomic_and_exact_end_opens_new_window",
        "tests/integration/db/test_orch_06_execution_control.py::test_orch_06_reservation_rollback_and_concurrent_unique_winner",
        "tests/integration/db/test_orch_06_execution_control.py::test_orch_06_busy_cancel_or_completion_is_sanitized_and_rolls_back",
        "tests/integration/db/test_orch_06_execution_control.py::test_orch_06_hmac_tamper_blocks_every_authoritative_record"
      ]
    },
    {
      "id": "bounded-read-timeout-retry-and-recovery",
      "type": "contract",
      "statement": "Controlled READ commits its attempt before calling outside the transaction, applies absolute UTC and monotonic timeout fences, retries only transient outcomes with persisted bounded backoff, and recovers crash-open attempts without double-counting or creating post-terminal retry authority.",
