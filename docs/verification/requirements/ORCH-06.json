        "tests/unit/application/test_orch_06_planning_budgets.py::test_orch_06_every_template_policy_change_changes_the_structural_plan_hash",
        "tests/unit/application/test_orch_06_planning_budgets.py::test_orch_06_forged_policy_with_original_hash_is_rejected",
        "tests/integration/db/test_orch_06_execution_control.py::test_orch_06_initialize_rejects_policy_inflation_or_incomplete_operation_set"
      ]
    },
    {
