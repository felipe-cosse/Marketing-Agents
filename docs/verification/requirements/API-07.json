    {
      "id": "authenticated-bounded-runtime-inspection",
      "type": "contract",
      "statement": "Every API-07 read requires an intact authenticated human viewer-equivalent role at transport and application boundaries before executor or repository access. Run and artifact lists use documented 25-item defaults, 100-item maxima, filter-bound opaque keyset cursors, deterministic secondary IDs, and bounded limit + 1 repository selection without count queries.",
      "test_refs": [
        "tests/integration/api/test_api_07_runtime_contracts.py::test_api_07_human_read_role_matrix",
        "tests/integration/api/test_api_07_runtime_contracts.py::test_api_07_authentication_and_authorization_precede_executor_resolution",
        "tests/integration/api/test_api_07_runtime_contracts.py::test_api_07_duplicate_queries_are_rejected_before_executor_resolution",
        "tests/integration/api/test_api_07_runtime_contracts.py::test_api_07_list_filters_and_malformed_executor_results_fail_closed",
        "tests/unit/application/test_api_07_run_resources.py::test_api_07_run_authorization_precedes_repository_access",
        "tests/unit/application/test_api_07_run_resources.py::test_api_07_run_cursor_is_filter_bound_and_opaque",
        "tests/unit/application/test_api_07_artifact_resources.py::test_api_07_artifact_authorization_precedes_repository_access",
        "tests/integration/db/test_api_07_inspection_repositories.py::test_api_07_repository_page_limits_and_cursor_pairs_are_bounded"
      ]
    },
