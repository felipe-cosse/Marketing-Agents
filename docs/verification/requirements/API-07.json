        "tests/unit/application/test_api_07_run_resources.py::test_api_07_composite_run_detail_projects_bounded_control_approval_and_artifact",
        "tests/unit/application/test_api_07_run_resources.py::test_api_07_composite_run_detail_fails_closed_on_coherence_drift",
        "tests/unit/application/test_api_07_run_resources.py::test_api_07_unknown_run_timeline_returns_not_found_before_audit_lookup",
