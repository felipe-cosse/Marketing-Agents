        "tests/integration/api/test_api_07_runtime_contracts.py::test_api_07_status_summary_has_private_strong_revalidation",
        "tests/integration/api/test_api_07_runtime_contracts.py::test_api_07_status_summary_preserves_all_43_catalog_ordered_items"
      ]
    },
    {
      "id": "safe-artifact-inspection",
      "type": "contract",
      "statement": "Artifact list summaries omit payload and hashes. Detail revalidates payload fingerprint, producer lineage, and classification at least as restrictive as the producer; applies persisted JSON-pointer plus conservative secret-field redaction; and returns a keyed pseudonymous digest, not the stored hash. SECRET artifacts fail closed as non-retainable. OpenAPI limits detail/source classifications to retainable public, internal, personal, and sensitive values; JSON remains inert data.",
      "test_refs": [
