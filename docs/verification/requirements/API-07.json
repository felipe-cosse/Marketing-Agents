      ]
    },
    {
      "id": "private-read-only-http-contract",
      "type": "contract",
      "statement": "Typed GET routes expose runs, timeline, steps, external actions, run artifacts, artifact detail, audit events, instance status, and dynamic recent runs with stable operation IDs. Exact result types and path/filter bindings are revalidated before serialization. Successful status and enriched instance detail use strong private revalidation; failures are private, no-store, nosniff, and non-reflective. API-07 adds no Run mutation or cancellation endpoint.",
      "test_refs": [
