  "claims": [
    {
      "id": "atomic-complete-set-release",
      "type": "contract",
      "statement": "Write-plan activation persists the Run plan, steps, external actions, approval requests, one complete authorization set, and its current head atomically. One approved member leaves every action paused; only the final fresh approval consumes every member, records each use and reservation, releases every WRITE step, and moves the Run to EXECUTING in one unit of work.",
      "test_refs": [
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_one_of_two_approvals_has_zero_release_then_final_is_atomic",
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_write_activation_fault_rolls_back_the_complete_plan_boundary",
        "tests/integration/db/test_orch_08_authorization_storage.py::test_orch_08_release_audit_fault_rolls_back_every_release_projection"
      ]
    },
    {
      "id": "zero-call-terminal-boundaries",
      "type": "negative_control",
      "statement": "A rejected member closes the whole current set without a use, reservation, attempt, or connector call; exact expiry remains paused; pre-release cancellation closes all remaining siblings without consumption; and post-release cancellation invalidates release authority so a future claim makes zero connector calls.",
      "test_refs": [
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_rejection_closes_full_mixed_plan_without_release",
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_expiry_and_pre_release_cancel_consume_nothing",
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_rejection_closes_an_expired_sibling_without_release",
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_post_release_cancel_blocks_claim_and_connector_call"
      ]
    },
    {
      "id": "sealed-release-authority-before-call",
      "type": "negative_control",
      "statement": "Every claim and call-start derives a sealed ReleaseAuthority from the committed current set, decision, use, reservation, Run, and WRITE step. Forged release hashes, decision-authority tamper, generic WRITE start, stale Run state, or lineage mismatch fail before a connector call; the first real call atomically commits its attempt marker and READY-to-EXECUTING step transition before leaving the transaction.",
      "test_refs": [
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_dispatch_forged_authority_is_zero_call_and_first_call_is_committed",
        "tests/integration/db/test_orch_08_authorization_storage.py::test_orch_08_released_decision_tamper_blocks_attempt_and_connector",
        "tests/integration/db/test_orch_08_authorization_storage.py::test_orch_08_retry_lineage_survives_intervening_pre_call_expiry"
      ]
    },
    {
      "id": "typed-boundary-audits-and-replay",
      "type": "contract",
      "statement": "Release writes linked action.dispatch_reserved and approval.consumed witnesses for every member plus Run and Step transitions; closure and dispatch mutations use exact typed redacted witnesses. Audit failure rolls back the boundary. Released, closed, and open-expiry replay validates every initial, renewed, current, and boundary member witness, returns stable current mixed-generation expiry IDs, and never heals missing history.",
      "test_refs": [
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_released_replay_requires_every_member_audit_without_healing",
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_open_expiry_replay_requires_every_audit_without_healing",
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_mixed_generation_expiry_result_is_replay_stable",
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_expiry_and_pre_release_cancel_consume_nothing",
        "tests/integration/db/test_orch_08_approval_boundary.py::test_orch_08_rejection_closes_an_expired_sibling_without_release",
        "tests/integration/db/test_orch_08_authorization_storage.py::test_orch_08_release_audit_fault_rolls_back_every_release_projection",
        "tests/unit/application/test_orch_08_audit_events.py::test_orch_08_release_member_audits_bind_use_reservation_and_decision",
        "tests/unit/application/test_orch_08_audit_events.py::test_orch_08_closed_sibling_audits_bind_optional_decision_exactly",
        "tests/unit/application/test_orch_08_audit_events.py::test_orch_08_dispatch_claim_and_call_start_audits_reject_delivery_drift"
      ]
    },
    {
      "id": "portable-relational-release-fences",
      "type": "contract",
      "statement": "Authorization-set heads, ordered members, approval uses, reservations, release hashes, released Run versions, and reserved WRITE-step transitions are constrained by exact composite keys and fail-closed hydration. The fresh SQLite schema enables foreign keys without violations, and every mapped table including these constraints compiles for SQLite and PostgreSQL dialects.",
