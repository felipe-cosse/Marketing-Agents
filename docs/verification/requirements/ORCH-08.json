        "tests/integration/db/test_orch_08_authorization_storage.py::test_orch_08_fresh_sqlite_schema_has_foreign_keys_and_no_violations",
        "tests/integration/db/test_orch_08_authorization_storage.py::test_orch_08_released_decision_tamper_blocks_attempt_and_connector"
      ]
    }
