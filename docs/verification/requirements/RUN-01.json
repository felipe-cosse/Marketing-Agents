        "tests/unit/domain/test_run_01_run_lifecycle.py::test_run_01_failures_are_phase_bound_and_completion_is_fail_closed",
        "tests/unit/domain/test_run_01_run_lifecycle.py::test_run_01_cancellation_reports_effects_only_after_execution_started"
      ]
    },
