        "tests/integration/db/test_run_01_lifecycle_persistence.py::test_run_01_lifecycle_survives_restart_with_ordered_terminal_history",
        "tests/integration/db/test_run_01_lifecycle_persistence.py::test_run_01_work_and_initial_run_share_caller_transaction",
