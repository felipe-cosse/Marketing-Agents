      "id": "adr-0004-command-only-lifecycle",
      "type": "contract",
      "statement": "Every existing Run state and public lifecycle command pair is explicit: legal commands create one contiguous versioned transition, illegal or terminal commands fail closed with safe evidence, and no API accepts an arbitrary target state.",
      "test_refs": [
        "tests/unit/domain/test_run_01_run_lifecycle.py::test_run_01_every_state_command_pair_is_explicit",
        "tests/unit/domain/test_run_01_run_lifecycle.py::test_run_01_read_only_path_is_contiguous_and_completes",
