  "claims": [
    {
      "id": "atomic-work-run-receipt",
      "type": "contract",
      "statement": "One validator-sealed admission creates or replays its authoritative WorkItem, primary Run, and sequence-one received transition in one caller-controlled transaction; mixed, misdirected, wrong-catalog, orphan, and post-flush faults cannot create or heal a partial pair.",
      "test_refs": [
        "tests/integration/db/test_orch_07_idempotent_receipts.py::test_orch_07_faults_and_caller_rollback_never_leave_partial_receipt",
        "tests/integration/db/test_orch_07_idempotent_receipts.py::test_orch_07_orphan_work_and_mixed_or_misdirected_runs_fail_closed",
        "tests/integration/db/test_orch_07_idempotent_receipts.py::test_orch_07_created_run_must_retain_marker_catalog_and_fk_blocks_orphan_run"
      ]
    },
    {
      "id": "authoritative-replay-and-collision",
      "type": "negative_control",
      "statement": "Independent sessions racing on one source-event-instance identity resolve to one WorkItem, one primary Run, and one initial transition: identical work returns created plus replayed original identities, while changed admitted semantics returns one creator plus one conflict.",
      "test_refs": [
        "tests/integration/db/test_orch_07_idempotent_receipts.py::test_orch_07_identical_and_changed_two_session_races_are_pair_atomic"
      ]
    },
    {
      "id": "catalog-fresh-first-admission-historical-replay",
      "type": "contract",
      "statement": "An unsealed, integrity-mutated, or stale catalog marker is rejected before a unit of work, clock, or ID generator is used; a newly validated catalog-only retry replays the original WorkItem and terminal primary Run with their historical catalog and configuration snapshot.",
      "test_refs": [
        "tests/integration/db/test_orch_07_idempotent_receipts.py::test_orch_07_unsealed_tampered_or_stale_marker_fails_before_authority_use",
        "tests/integration/db/test_orch_07_idempotent_receipts.py::test_orch_07_atomic_receipt_replays_original_after_terminal_and_catalog_release"
      ]
    },
    {
      "id": "pure-classified-action-recovery",
      "type": "negative_control",
      "statement": "A pure policy classifies the persisted stale ExternalAction snapshot: pre-call leases retry any provider class only within budget, post-call leases retry only required or supported idempotency within budget, and every other post-call case becomes outcome-unknown after durable-receipt reconciliation.",
      "test_refs": [
        "tests/unit/application/test_orch_07_action_recovery.py::test_orch_07_recovery_classifier_has_complete_fail_closed_truth_table",
        "tests/unit/application/test_orch_07_action_recovery.py::test_orch_07_recovery_classifier_rejects_nonpersisted_or_unexpired_state",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_stale_crash_after_receipt_reconciles_without_provider_call",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_final_attempt_lost_response_reconciles_durable_receipt",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_run_05_unavailable_post_call_stale_never_blind_retries"
      ]
    }
  ],
