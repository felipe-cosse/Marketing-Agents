  "claims": [
    {
      "id": "safe-local-configuration",
      "type": "negative_control",
      "statement": "Tracked and Docker contexts exclude local secrets and state while the example environment stays mock-only and loopback-bound.",
      "test_refs": ["tests/security/test_safe_10_secret_hygiene.py::SecretHygieneTests"]
    },
    {
      "id": "secret-detection-and-masking",
      "type": "negative_control",
      "statement": "High-confidence credential canaries and forbidden secret filenames are detected, while nested diagnostic fields and secret reprs are masked.",
