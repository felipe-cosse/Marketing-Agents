    },
    {
      "id": "restart-safe-digest-key",
      "type": "contract",
      "statement": "The local digest key is atomically created once with private permissions and fails closed on missing, mismatched, symlinked, or unsafe material.",
      "test_refs": ["tests/security/test_safe_10_secret_hygiene.py::SecretHygieneTests"]
    }
  ],
  "gates": [
    {
      "id": "safe-10-unit",
