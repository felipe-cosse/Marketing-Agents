  "claims": [
    {
      "id": "exclusive-active-due-instant-claim",
      "type": "contract",
      "statement": "Two independent services synchronize on the same due/version snapshot through separate file-backed SQLite sessions. One exact version, due-instant, digest, enabled, and lease-availability CAS commits; the loser receives no claim, the due instant is unchanged, the version advances once, and no Work or Run is created.",
      "test_refs": [
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_two_independent_workers_race_to_one_claim"
      ]
    },
    {
      "id": "strict-lease-eligibility-and-fencing",
      "type": "negative_control",
      "statement": "The bounded ordered scan includes enabled schedules due at or before the injected UTC boundary and excludes future, disabled, and active leases. Exact expiry remains active; only a strictly expired lease can be replaced, and replacement preserves the due instant while issuing a new owner/version fencing tuple.",
      "test_refs": [
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_strict_expiry_reclaims_with_a_new_fencing_version",
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_due_scan_is_bounded_ordered_and_filters_future_or_disabled"
      ]
    },
    {
      "id": "durable-fail-closed-lease-state",
      "type": "negative_control",
      "statement": "A committed claim survives restart with its exact owner, due instant, claim and expiry times, and version. Stale version or due facts, uncommitted claims, malformed lease tuples, unrecomputed lease drift, invalid inputs, and SQLite busy snapshots cannot create a durable owner; SQLite and PostgreSQL DDL retain portable lease constraints.",
      "test_refs": [
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_two_independent_workers_race_to_one_claim",
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_stale_due_and_uncommitted_claims_fail_closed",
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_lease_schema_is_portable_and_constrained",
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_database_rejects_invalid_lease_tuples",
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_lease_drift_without_digest_recomputation_fails_closed",
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_sqlite_busy_is_a_lost_claim_not_an_owner",
        "tests/integration/scheduler/test_sched_02_concurrent_claim.py::test_sched_02_invalid_owner_clock_duration_and_expiry_fail_before_write"
      ]
    }
  ],
