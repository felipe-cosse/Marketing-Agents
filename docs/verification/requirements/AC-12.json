  "claims": [
    {
      "id": "configured-dst-race-and-restart",
      "type": "journey",
      "statement": "Public configuration, independently reconstructed default runtimes and real workers preserve spring-gap and first-fold selections; two genuine due scans race to one occurrence/work/run and one post-restart model artifact with no connector calls. Public audits agree with the durable calendar evidence.",
      "test_refs": [
        "tests/acceptance/test_ac_12_scheduler_recovery.py"
      ]
    },
    {
      "id": "abandoned-claim-misfire-recovery",
      "type": "journey",
      "statement": "A genuinely committed abandoned claim remains fenced through exact expiry. Reconstructed default workers race after expiry: skip creates no work; run_once creates one original-due work/run, preserving the three-occurrence range and its interior spring-gap adjustment without a backlog burst.",
      "test_refs": [
        "tests/acceptance/test_ac_12_scheduler_recovery.py",
        "tests/integration/scheduler/test_ac_12_resolution_replay.py"
      ]
    },
    {
      "id": "durable-resolution-integrity",
      "type": "positive",
      "statement": "Typed pending, due, next and coalesced adjustment evidence survives additive migration, claims, CAS, rollback and reconstruction. Historical NULL snapshots and digests remain unchanged; canonical snapshot tampering, replay mismatches and recorded-to-NULL downgrade fail closed. Bounded audit summaries bind full adjustment lists without retaining business input.",
      "test_refs": [
        "tests/integration/db/test_ac_12_recurrence_persistence.py",
        "tests/unit/scheduler/test_ac_12_recurrence_resolution.py",
        "tests/unit/scheduler/test_ac_12_recurrence_audit.py",
        "tests/integration/scheduler/test_ac_12_resolution_replay.py"
      ]
    },
    {
      "id": "configuration-and-existing-fences-preserved",
      "type": "positive",
      "statement": "Disabled schedule edits recompute changed cron/timezone evidence while disable-only preserves its pending snapshot. Existing UTC, claim, rollback, replay, configuration, migration and audit safety contracts remain enforced.",
      "test_refs": [
        "tests/acceptance/test_ac_12_scheduler_recovery.py"
      ]
    }
  ],
