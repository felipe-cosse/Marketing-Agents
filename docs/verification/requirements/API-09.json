  "claims": [
    {
      "id": "bounded-api-and-runtime-deadlines",
      "type": "negative_control",
      "statement": "The ASGI boundary gives each request one lifetime, cancels one timeout, never retries a route, returns a safe 503 before response start, and never double-starts a stream. Durable READ and WRITE attempts retain retry, call, and Run-deadline bounds; exhaustion adds no attempt. A lost Run compare-and-swap persists its rejection in at most three attempts separated by two bounded waits outside transactions, preserving stale_run_version after the winner commits.",
      "test_refs": [
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_timeout_cancels_once_without_retry",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_timeout_after_response_start_never_double_starts",
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_api_09_retry_deadline_exhaustion_fails_run_without_extra_attempt",
        "tests/integration/db/test_run_01_lifecycle_persistence.py::test_run_01_two_sessions_allow_exactly_one_expected_version_transition",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_orch_06_write_timeout_is_minimum_of_all_durable_bounds",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_orch_06_call_start_commit_latency_cannot_extend_absolute_deadline"
      ]
    },
    {
      "id": "atomic-terminal-run-failures",
      "type": "contract",
      "statement": "An ordinary terminal READ or WRITE fails the focal step and Run atomically, closes queued or provably pre-call siblings, and records terminal_failure_origin as ordinary execution or runtime-control denial. Started writes reconcile an exact durable receipt first; without one, recovery maps the origin, uses a safe generic fallback for legacy originless audits, and refuses replay when the exact failed-Run mutation witness is missing.",
      "test_refs": [
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_api_09_terminal_read_failure_fails_run_and_audits_safe_cause",
        "tests/integration/db/test_orch_06_controlled_read_executor.py::test_api_09_retry_deadline_exhaustion_fails_run_without_extra_attempt",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_api_09_terminal_cleanup_rejects_nonterminal_runtime_control_code",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_api_09_terminal_write_failure_closes_only_pre_call_siblings",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_api_09_ordinary_read_exhaustion_reconciles_inflight_write_receipt",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_api_09_pre_call_read_exhaustion_marks_runtime_control_write_recovery",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_api_09_legacy_failed_parent_reconciles_receipt_before_origin_lookup",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_api_09_legacy_failed_parent_without_origin_uses_generic_no_receipt_reason",
        "tests/integration/db/test_run_05_external_action_idempotency.py::test_api_09_failed_parent_missing_exact_audit_fails_closed_without_replay"
      ]
    },
    {
      "id": "safe-terminal-resource-projection",
      "type": "contract",
      "statement": "Failed Run detail exposes one bounded terminal_error from coherent Run, step, control, and attempt facts. Exact final READ causes are shown; recognized no-attempt pre-call failures use source=step; post-call denials require final-attempt mapping. Unsafe terminal IDs, missing or drifting lineage, and impossible post-call facts fail closed, while provider text, payloads, headers, and secrets are never projected.",
      "test_refs": [
        "tests/unit/application/test_api_09_terminal_error_projection.py::test_api_09_run_detail_exposes_terminal_retry_and_safe_adapter_cause",
        "tests/unit/application/test_api_09_terminal_error_projection.py::test_api_09_read_failure_without_attempt_projects_step_error",
        "tests/unit/application/test_api_09_terminal_error_projection.py::test_api_09_pre_call_write_failure_without_action_projects_step_error",
        "tests/unit/application/test_api_09_terminal_error_projection.py::test_api_09_unknown_terminal_identifier_fails_closed",
        "tests/unit/application/test_api_09_terminal_error_projection.py::test_api_09_post_call_denial_without_attempt_fails_closed"
      ]
    },
    {
      "id": "unified-problems-and-server-correlation",
      "type": "contract",
      "statement": "The installed API boundary gives application failures one strict application/problem+json occurrence shape with no-store and security headers, bounded optional fields, non-reflective framework validation, safe header preservation, and one unpredictable server-owned correlation ID shared by the response and admitted command. Caller correlation and arbitrary exception headers are discarded.",
      "test_refs": [
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_framework_and_route_errors_share_strict_problem_details",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_duplicate_host_and_caller_correlation_are_not_trusted",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_real_route_command_reuses_response_correlation"
      ]
    },
    {
      "id": "same-origin-direct-transport-boundary",
      "type": "negative_control",
      "statement": "The local browser control plane issues a private process token and admits unsafe API mutations only with exact JSON transport, one canonical trusted Origin, same-origin Fetch Metadata, and the current CSRF token. Strict Host parsing and direct-mode rejection of Forwarded and X-Forwarded-* precede handlers. The exact signature-first webhook route remains CSRF-exempt without altering receive bytes.",
      "test_refs": [
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_session_is_private_bounded_and_per_process",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_settings_reject_noncanonical_trusted_origins",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_host_and_direct_proxy_rejections_precede_handlers",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_browser_mutation_rejections_are_generic_and_pre_handler",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_browser_mutation_accepts_only_current_same_origin_token",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_duplicate_browser_security_headers_fail_closed",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_browser_policy_is_root_path_safe_when_mounted",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_webhook_exemption_preserves_exact_receive_bytes",
        "tests/integration/api/test_run_10_identity_dependency.py::test_api_09_direct_mode_proxy_headers_fail_before_provider",
        "tests/integration/db/test_api_04_manual_work_persistence.py::test_api_04_http_route_composes_real_service_resolver_and_durable_uow"
      ]
    },
    {
      "id": "bounded-authenticated-webhook-admission",
      "type": "negative_control",
      "statement": "Webhook admission verifies the exact signed request before consuming a fixed-window slot keyed by the authenticated source. Denial precedes envelope parsing, workflow resolution, Work, Run, and receipt persistence, and provider work; only redacted webhook.signature_validated and ingress.rate_limited audits persist. Windows roll over exactly, resist clock rollback, bound cardinality, fail closed, and return bounded Retry-After.",
      "test_refs": [
        "tests/unit/application/test_api_09_webhook_rate_limit.py::test_api_09_rate_limiter_uses_exact_windows_and_resists_clock_rollback",
        "tests/unit/application/test_api_09_webhook_rate_limit.py::test_api_09_rate_limiter_bounds_trusted_source_cardinality_and_prunes",
        "tests/unit/application/test_api_09_webhook_rate_limit.py::test_api_09_only_authenticated_sources_consume_and_denial_precedes_mapping",
        "tests/unit/application/test_api_09_webhook_rate_limit.py::test_api_09_rate_limit_audit_is_verified_redacted_and_bounded",
        "tests/integration/db/test_api_05_webhook_intake.py::test_api_09_authenticated_rate_denial_is_audited_before_429_and_fails_closed",
        "tests/integration/api/test_api_05_webhooks.py::test_api_09_rate_limit_problem_preserves_retry_contract"
      ]
    },
    {
      "id": "live-openapi-problem-contract",
      "type": "contract",
      "statement": "The live FastAPI OpenAPI document contains the strict ProblemDetails schema and rewrites documented application error responses to only application/problem+json, including the session and mutation surfaces, while runtime 404, 405, route, validation, and unhandled failures conform to that same bounded occurrence model.",
      "test_refs": [
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_openapi_uses_one_problem_details_media_type",
        "tests/integration/api/test_api_09_transport_security.py::test_api_09_framework_and_route_errors_share_strict_problem_details"
      ]
    }
  ],
