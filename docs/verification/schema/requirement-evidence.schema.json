{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-agents:requirement-evidence:v1",
  "title": "Marketing Agents requirement evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "requirement_id",
    "matrix_statement_sha256",
    "evidence_class",
    "scope",
    "claims",
    "gates",
    "limitations"
  ],
  "properties": {
    "$schema": {"const": "../schema/requirement-evidence.schema.json"},
    "schema_version": {"const": 1},
    "requirement_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
    "matrix_statement_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_class": {
      "enum": ["source_boundary", "decision_record", "process_gate", "tooling_control", "product", "security_control", "acceptance"]
    },
    "legacy_bootstrap": {"type": "boolean"},
    "legacy_manifest_added_at": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_path_globs", "required_path_groups"],
      "properties": {
        "allowed_path_globs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "required_path_groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "one_of"],
            "properties": {
              "kind": {"enum": ["source", "decision", "implementation", "control", "test", "journey"]},
              "one_of": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "statement", "test_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
          "type": {"enum": ["positive", "negative_control", "contract", "journey", "documentation"]},
          "statement": {"type": "string", "minLength": 10, "maxLength": 500},
          "test_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3, "maxLength": 300}
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runner", "argv", "cwd", "timeout_seconds", "network_requirement", "covers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
          "runner": {"const": "argv"},
          "argv": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 300}
          },
          "cwd": {"type": "string", "minLength": 1, "maxLength": 200},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
          "network_requirement": {"enum": ["not_required", "not_enforced", "loopback_only", "deny"]},
          "covers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 80}
          }
        }
      }
    },
    "connection_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_path_globs", "gate_id"],
      "properties": {
        "implementation_path_globs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "gate_id": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 10, "maxLength": 500}
    }
  }
}
